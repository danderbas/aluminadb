DELIMITER //
CREATE PROCEDURE infomatrizp (IN curr_cod_matriz VARCHAR(30), IN curr_nro_serie_matriz INT)
BEGIN
	SELECT
		matrices.codigo,
		nro_serie_matriz,
		matrices.id_tipo,
		nro_salidas,
		es_fragil,
		extrusion_matriz.nro_extrusion,
		CAST(avgpesolineal AS DECIMAL(4,3)) avg_PL,
		CAST(100*(avgpesolineal/perfiles.pesolinealnominal__kg_m-1) AS DECIMAL(4,3)) dif_porc_PL
	FROM matrices
		JOIN extrusion_matriz
			ON matrices.codigo=extrusion_matriz.cod_matriz
		JOIN extrusion_pesolineal_v
			ON extrusion_matriz.nro_extrusion=extrusion_pesolineal_v.nro_extrusion 
		JOIN perfiles
			ON perfiles.codigo=matrices.cod_perfil
	WHERE matrices.codigo LIKE curr_cod_matriz AND nro_serie_matriz=curr_nro_serie_matriz;
END //
delimiter ;

DELIMITER //
CREATE PROCEDURE infomatriz (IN curr_cod_matriz VARCHAR(30), IN curr_nro_serie_matriz INT, OUT nro_nitruraciones_out INT, OUT kg_dsdultnit_out FLOAT)
BEGIN
	SET @maxvalue_max__kg = (SELECT max(max__kg) FROM nitruracion_kgmax JOIN matrices ON nitruracion_kgmax.es_fragil=matrices.es_fragil where matrices.codigo like curr_cod_matriz);

	WITH hojadevida_running AS (
		SELECT cod_matriz, nro_serie_matriz, fecha, kg,
			SUM(accion = 'NITRURACION') OVER (ORDER BY fecha ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS nro_nitruraciones
		FROM matrices_hojadevida_v
		WHERE cod_matriz=curr_cod_matriz AND nro_serie_matriz=curr_nro_serie_matriz
	), hojadevida_estado AS (
		SELECT cod_matriz, nro_serie_matriz, fecha, nro_nitruraciones,
			SUM(kg) OVER (PARTITION BY nro_nitruraciones ORDER BY fecha ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS kg_dsdultnit
		FROM hojadevida_running
	)
	SELECT
		e.cod_matriz,
		e.nro_serie_matriz,
		e.nro_nitruraciones,
		e.kg_dsdultnit,
		IF(k.max__kg is null,@maxvalue_max__kg,k.max__kg) kg_max,
		IF(k.max__kg is null,@maxvalue_max__kg,k.max__kg)-e.kg_dsdultnit as kg_disponibles
	FROM hojadevida_estado e
		JOIN matrices m ON e.cod_matriz=m.codigo
		LEFT JOIN nitruracion_kgmax k ON e.nro_nitruraciones=k.nro_nitruraciones AND k.es_fragil=m.es_fragil
	ORDER BY e.fecha DESC LIMIT 1;

	WITH hojadevida_running AS (
		SELECT fecha, kg,
			SUM(accion = 'NITRURACION') OVER (ORDER BY fecha ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS nro_nitruraciones
		FROM matrices_hojadevida_v
		WHERE cod_matriz=curr_cod_matriz AND nro_serie_matriz=curr_nro_serie_matriz
	)
	SELECT nro_nitruraciones,
		SUM(kg) OVER (PARTITION BY nro_nitruraciones ORDER BY fecha ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
	INTO nro_nitruraciones_out, kg_dsdultnit_out
	FROM hojadevida_running
	ORDER BY fecha DESC LIMIT 1;
END //
DELIMITER ;

DELIMITER //
CREATE PROCEDURE infoperfil (IN curr_cod_perfil VARCHAR(30))
BEGIN
	SELECT * FROM stock_matrices JOIN matrices ON stock_matrices.cod_matriz=matrices.codigo WHERE cod_perfil LIKE curr_cod_perfil;
END //
DELIMITER ;
