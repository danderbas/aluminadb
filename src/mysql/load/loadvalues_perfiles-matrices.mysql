LOAD DATA LOCAL INFILE '@@CSVFOLDER@@/perfiles.csv' INTO TABLE s_perfiles FIELDS TERMINATED BY ',' ENCLOSED BY '"' LINES TERMINATED BY '\n' IGNORE 1 ROWS
	(codigo, descripcion, id_tipo, pesolinealnominal__kg_m, perimetro__mm, area__mm2, codigo_externo, es_extrusable);

INSERT INTO perfiles (codigo,descripcion,id_tipo,pesolinealnominal__kg_m,perimetro__mm,area__mm2,codigo_externo,es_extrusable)
	SELECT codigo,descripcion,id_tipo,pesolinealnominal__kg_m,perimetro__mm,area__mm2,codigo_externo,es_extrusable FROM (
		SELECT s.*, tp.id AS tipo_ok,
			ROW_NUMBER() OVER (PARTITION BY s.codigo ORDER BY s._csv_row) AS rn
		FROM s_perfiles s
			LEFT JOIN tipos_perfiles tp ON tp.id=s.id_tipo
	) t
	WHERE tipo_ok IS NOT NULL AND rn=1;

SELECT 'perfiles' AS staging_check,
	(SELECT COUNT(*) FROM s_perfiles) AS staged,
	(SELECT COUNT(*) FROM perfiles) AS loaded,
	(SELECT COUNT(*) FROM s_perfiles)-(SELECT COUNT(*) FROM perfiles) AS dropped;

SELECT s._csv_row, s.codigo, s.id_tipo, tp.id AS tipo_found
	FROM s_perfiles s
		LEFT JOIN tipos_perfiles tp ON tp.id=s.id_tipo
	WHERE tp.id IS NULL
		OR s._csv_row NOT IN (SELECT MIN(_csv_row) FROM s_perfiles GROUP BY codigo);

LOAD DATA LOCAL INFILE '@@CSVFOLDER@@/matrices.matrices.csv' INTO TABLE matrices FIELDS TERMINATED BY ',' ENCLOSED BY '"' LINES TERMINATED BY '\n' IGNORE 1 ROWS
	(codigo, id_tipo, cod_perfil, nro_salidas, id_proveedor, es_fragil);
LOAD DATA LOCAL INFILE '@@CSVFOLDER@@/matrices.stock_matrices.csv' INTO TABLE stock_matrices FIELDS TERMINATED BY ',' ENCLOSED BY '"' LINES TERMINATED BY '\n' IGNORE 1 ROWS
	(cod_matriz, nro_serie, grabado);

LOAD DATA LOCAL INFILE '@@CSVFOLDER@@/matrices.correcciones.csv' INTO TABLE s_matrices_correccion FIELDS TERMINATED BY ',' ENCLOSED BY '"' LINES TERMINATED BY '\n' IGNORE 1 ROWS
	(fecha, id_rrhh, cod_matriz, nro_serie_matriz, descripcion);

INSERT INTO matrices_correccion (fecha,id_rrhh,cod_matriz,nro_serie_matriz,descripcion)
	SELECT s.fecha,s.id_rrhh,s.cod_matriz,s.nro_serie_matriz,s.descripcion
	FROM s_matrices_correccion s
		JOIN stock_matrices sm ON sm.cod_matriz=s.cod_matriz AND sm.nro_serie=s.nro_serie_matriz
		JOIN rrhh r ON r.id=s.id_rrhh;

SELECT 'matrices_correccion' AS staging_check,
	(SELECT COUNT(*) FROM s_matrices_correccion) AS staged,
	(SELECT COUNT(*) FROM matrices_correccion) AS loaded,
	(SELECT COUNT(*) FROM s_matrices_correccion)-(SELECT COUNT(*) FROM matrices_correccion) AS dropped;

SELECT s._csv_row, s.fecha, s.id_rrhh, s.cod_matriz, s.nro_serie_matriz, sm.cod_matriz AS matriz_found, r.id AS rrhh_found
	FROM s_matrices_correccion s
		LEFT JOIN stock_matrices sm ON sm.cod_matriz=s.cod_matriz AND sm.nro_serie=s.nro_serie_matriz
		LEFT JOIN rrhh r ON r.id=s.id_rrhh
	WHERE sm.cod_matriz IS NULL OR r.id IS NULL;

LOAD DATA LOCAL INFILE '@@CSVFOLDER@@/matrices.mediciondureza.csv' INTO TABLE s_matrices_mediciondureza FIELDS TERMINATED BY ',' ENCLOSED BY '"' LINES TERMINATED BY '\n' IGNORE 1 ROWS
	(fecha, id_rrhh, cod_matriz, nro_serie_matriz, dureza__rhc);

INSERT INTO matrices_mediciondureza (fecha,id_rrhh,cod_matriz,nro_serie_matriz,dureza__rhc)
	SELECT fecha,id_rrhh,cod_matriz,nro_serie_matriz,dureza__rhc FROM (
		SELECT s.*, sm.cod_matriz AS matriz_ok, r.id AS rrhh_ok,
			ROW_NUMBER() OVER (PARTITION BY s.cod_matriz,s.nro_serie_matriz,s.fecha ORDER BY s._csv_row) AS rn
		FROM s_matrices_mediciondureza s
			LEFT JOIN stock_matrices sm ON sm.cod_matriz=s.cod_matriz AND sm.nro_serie=s.nro_serie_matriz
			LEFT JOIN rrhh r ON r.id=s.id_rrhh
	) t
	WHERE matriz_ok IS NOT NULL AND rrhh_ok IS NOT NULL AND rn=1;

SELECT 'matrices_mediciondureza' AS staging_check,
	(SELECT COUNT(*) FROM s_matrices_mediciondureza) AS staged,
	(SELECT COUNT(*) FROM matrices_mediciondureza) AS loaded,
	(SELECT COUNT(*) FROM s_matrices_mediciondureza)-(SELECT COUNT(*) FROM matrices_mediciondureza) AS dropped;

SELECT s._csv_row, s.fecha, s.id_rrhh, s.cod_matriz, s.nro_serie_matriz, s.dureza__rhc, sm.cod_matriz AS matriz_found, r.id AS rrhh_found
	FROM s_matrices_mediciondureza s
		LEFT JOIN stock_matrices sm ON sm.cod_matriz=s.cod_matriz AND sm.nro_serie=s.nro_serie_matriz
		LEFT JOIN rrhh r ON r.id=s.id_rrhh
	WHERE sm.cod_matriz IS NULL OR r.id IS NULL
		OR s._csv_row NOT IN (SELECT MIN(_csv_row) FROM s_matrices_mediciondureza GROUP BY cod_matriz,nro_serie_matriz,fecha);

LOAD DATA LOCAL INFILE '@@CSVFOLDER@@/matrices.nitruracion.csv' INTO TABLE s_matrices_nitruracion FIELDS TERMINATED BY ',' ENCLOSED BY '"' LINES TERMINATED BY '\n' IGNORE 1 ROWS
	(fecha_salida, fecha_retorno, id_rrhh_salida, id_rrhh_retorno, cod_matriz, nro_serie_matriz);

INSERT INTO matrices_nitruracion (fecha_salida,fecha_retorno,id_rrhh_salida,id_rrhh_retorno,cod_matriz,nro_serie_matriz)
	SELECT fecha_salida,fecha_retorno,id_rrhh_salida,id_rrhh_retorno,cod_matriz,nro_serie_matriz FROM (
		SELECT s.*, sm.cod_matriz AS matriz_ok, r1.id AS rrhh_salida_ok, r2.id AS rrhh_retorno_ok,
			ROW_NUMBER() OVER (PARTITION BY s.fecha_salida,s.cod_matriz,s.nro_serie_matriz ORDER BY s._csv_row) AS rn_salida,
			ROW_NUMBER() OVER (PARTITION BY s.fecha_retorno,s.cod_matriz,s.nro_serie_matriz ORDER BY s._csv_row) AS rn_retorno
		FROM s_matrices_nitruracion s
			LEFT JOIN stock_matrices sm ON sm.cod_matriz=s.cod_matriz AND sm.nro_serie=s.nro_serie_matriz
			LEFT JOIN rrhh r1 ON r1.id=s.id_rrhh_salida
			LEFT JOIN rrhh r2 ON r2.id=s.id_rrhh_retorno
	) t
	WHERE matriz_ok IS NOT NULL AND rrhh_salida_ok IS NOT NULL
		AND (id_rrhh_retorno IS NULL OR rrhh_retorno_ok IS NOT NULL)
		AND (fecha_retorno IS NULL OR fecha_salida <= fecha_retorno)
		AND rn_salida=1
		AND (fecha_retorno IS NULL OR rn_retorno=1);

SELECT 'matrices_nitruracion' AS staging_check,
	(SELECT COUNT(*) FROM s_matrices_nitruracion) AS staged,
	(SELECT COUNT(*) FROM matrices_nitruracion) AS loaded,
	(SELECT COUNT(*) FROM s_matrices_nitruracion)-(SELECT COUNT(*) FROM matrices_nitruracion) AS dropped;

SELECT s._csv_row, s.fecha_salida, s.fecha_retorno, s.id_rrhh_salida, s.id_rrhh_retorno, s.cod_matriz, s.nro_serie_matriz,
		sm.cod_matriz AS matriz_found, r1.id AS rrhh_salida_found, r2.id AS rrhh_retorno_found
	FROM s_matrices_nitruracion s
		LEFT JOIN stock_matrices sm ON sm.cod_matriz=s.cod_matriz AND sm.nro_serie=s.nro_serie_matriz
		LEFT JOIN rrhh r1 ON r1.id=s.id_rrhh_salida
		LEFT JOIN rrhh r2 ON r2.id=s.id_rrhh_retorno
	WHERE sm.cod_matriz IS NULL OR r1.id IS NULL OR (s.id_rrhh_retorno IS NOT NULL AND r2.id IS NULL)
		OR (s.fecha_retorno IS NOT NULL AND s.fecha_salida > s.fecha_retorno)
		OR s._csv_row NOT IN (SELECT MIN(_csv_row) FROM s_matrices_nitruracion GROUP BY fecha_salida,cod_matriz,nro_serie_matriz)
		OR (s.fecha_retorno IS NOT NULL AND s._csv_row NOT IN (SELECT MIN(_csv_row) FROM s_matrices_nitruracion WHERE fecha_retorno IS NOT NULL GROUP BY fecha_retorno,cod_matriz,nro_serie_matriz));
