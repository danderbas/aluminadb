LOAD DATA LOCAL INFILE '@@CSVFOLDER@@/envejecimiento.envejecimiento.csv' INTO TABLE envejecimiento FIELDS TERMINATED BY ',' ENCLOSED BY '"' LINES TERMINATED BY '\n' IGNORE 1 ROWS
	(nro, fecha_inicio, hora_inicio, id_rrhh_inicio, fecha_fin, hora_fin, id_rrhh_fin);

LOAD DATA LOCAL INFILE '@@CSVFOLDER@@/envejecimiento.canastos.csv' INTO TABLE envejecimiento_canastos FIELDS TERMINATED BY ',' ENCLOSED BY '"' LINES TERMINATED BY '\n' IGNORE 1 ROWS
	(nro_canasto, nro_envejecimiento, id_tipo_contenedor, id_contenedor);

LOAD DATA LOCAL INFILE '@@CSVFOLDER@@/envejecimiento.contenido.csv' INTO TABLE envejecimiento_canastos_detalle FIELDS TERMINATED BY ',' ENCLOSED BY '"' LINES TERMINATED BY '\n' IGNORE 1 ROWS
	(nro_canasto, cod_perfil, long_perfil__m, cantidad, nro_op, nro_subop, @dummy1, @dummy2);
