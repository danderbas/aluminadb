LOAD DATA LOCAL INFILE '@@CSVFOLDER@@/extrusion.extrusion.csv' INTO TABLE s_extrusion FIELDS TERMINATED BY ',' ENCLOSED BY '"' LINES TERMINATED BY '\n' IGNORE 1 ROWS
	(nro, fecha, hora_inicio, hora_fin, id_rrhh, nro_op, nro_subop, cod_perfil);
INSERT INTO extrusion (nro,fecha,hora_inicio,hora_fin,id_rrhh,nro_op,nro_subop,cod_perfil)
	SELECT s.nro,s.fecha,s.hora_inicio,s.hora_fin,s.id_rrhh,s.nro_op,s.nro_subop,s.cod_perfil
	FROM s_extrusion s
	LEFT JOIN op_extrusion o ON o.nro_op=s.nro_op AND o.nro_subop=s.nro_subop
	WHERE s.nro_op IS NULL OR s.nro_subop IS NULL OR o.cod_perfil=s.cod_perfil;
SELECT 'extrusion' AS staging_check,
	(SELECT COUNT(*) FROM s_extrusion) AS staged,
	(SELECT COUNT(*) FROM extrusion) AS loaded,
	(SELECT COUNT(*) FROM s_extrusion)-(SELECT COUNT(*) FROM extrusion) AS dropped;
SELECT s.nro AS staging_nro, s.nro_op, s.nro_subop, s.cod_perfil AS staged_cod_perfil, o.cod_perfil AS op_cod_perfil
	FROM s_extrusion s
	LEFT JOIN op_extrusion o ON o.nro_op=s.nro_op AND o.nro_subop=s.nro_subop
	WHERE NOT (s.nro_op IS NULL OR s.nro_subop IS NULL OR o.cod_perfil=s.cod_perfil);

CREATE TEMPORARY TABLE chk_extrusion_raw (nro INT, fecha DATE, hora_inicio TIME, hora_fin TIME, id_rrhh INT, nro_op INT, nro_subop INT, cod_perfil VARCHAR(30));
LOAD DATA LOCAL INFILE '@@CSVFOLDER@@/extrusion.extrusion.csv' INTO TABLE chk_extrusion_raw FIELDS TERMINATED BY ',' ENCLOSED BY '"' LINES TERMINATED BY '\n' IGNORE 1 ROWS
	(nro, fecha, hora_inicio, hora_fin, id_rrhh, nro_op, nro_subop, cod_perfil);
SELECT 'extrusion (pre-staging)' AS staging_check,
	COUNT(*) AS in_csv,
	SUM(s.nro IS NOT NULL) AS staged,
	SUM(s.nro IS NULL) AS dropped_before_staging
	FROM chk_extrusion_raw r LEFT JOIN s_extrusion s ON s.nro=r.nro;
SELECT r.nro, r.nro_op, r.nro_subop, r.cod_perfil
	FROM chk_extrusion_raw r
	LEFT JOIN op_extrusion o ON o.nro_op=r.nro_op AND o.nro_subop=r.nro_subop
	WHERE r.nro_op IS NOT NULL AND r.nro_subop IS NOT NULL AND o.nro_op IS NULL;
DROP TEMPORARY TABLE chk_extrusion_raw;

LOAD DATA LOCAL INFILE '@@CSVFOLDER@@/extrusion.matriz.csv' INTO TABLE s_extrusion_matriz FIELDS TERMINATED BY ',' ENCLOSED BY '"' LINES TERMINATED BY '\n' IGNORE 1 ROWS
	(nro_extrusion, cod_matriz, nro_serie_matriz);
INSERT INTO extrusion_matriz (nro_extrusion,cod_matriz,nro_serie_matriz)
	SELECT s.nro_extrusion,s.cod_matriz,s.nro_serie_matriz
	FROM s_extrusion_matriz s
	JOIN extrusion e ON e.nro=s.nro_extrusion
	JOIN matrices m ON m.codigo=s.cod_matriz
	WHERE e.cod_perfil=m.cod_perfil;
SELECT 'extrusion_matriz' AS staging_check,
	(SELECT COUNT(*) FROM s_extrusion_matriz) AS staged,
	(SELECT COUNT(*) FROM extrusion_matriz) AS loaded,
	(SELECT COUNT(*) FROM s_extrusion_matriz)-(SELECT COUNT(*) FROM extrusion_matriz) AS dropped;
-- which staged rows were dropped, and why
SELECT s.nro_extrusion, s.cod_matriz, s.nro_serie_matriz,
		e.cod_perfil AS extrusion_cod_perfil, m.cod_perfil AS matriz_cod_perfil
	FROM s_extrusion_matriz s
	LEFT JOIN extrusion e ON e.nro=s.nro_extrusion
	LEFT JOIN matrices m ON m.codigo=s.cod_matriz
	WHERE e.nro IS NULL OR m.codigo IS NULL OR e.cod_perfil <> m.cod_perfil;

CREATE TEMPORARY TABLE chk_extrusion_matriz_raw (nro_extrusion INT, cod_matriz VARCHAR(30), nro_serie_matriz INT);
LOAD DATA LOCAL INFILE '@@CSVFOLDER@@/extrusion.matriz.csv' INTO TABLE chk_extrusion_matriz_raw FIELDS TERMINATED BY ',' ENCLOSED BY '"' LINES TERMINATED BY '\n' IGNORE 1 ROWS
	(nro_extrusion, cod_matriz, nro_serie_matriz);
SELECT 'extrusion_matriz (pre-staging)' AS staging_check,
	COUNT(*) AS in_csv,
	SUM(s.nro_extrusion IS NOT NULL) AS staged,
	SUM(s.nro_extrusion IS NULL) AS dropped_before_staging
	FROM chk_extrusion_matriz_raw r LEFT JOIN s_extrusion_matriz s ON s.nro_extrusion=r.nro_extrusion;
SELECT r.* FROM chk_extrusion_matriz_raw r
	LEFT JOIN extrusion e ON e.nro=r.nro_extrusion
	WHERE e.nro IS NULL;
DROP TEMPORARY TABLE chk_extrusion_matriz_raw;

LOAD DATA LOCAL INFILE '@@CSVFOLDER@@/extrusion.tochos.csv' INTO TABLE extrusion_entrada FIELDS TERMINATED BY ',' ENCLOSED BY '"' LINES TERMINATED BY '\n' IGNORE 1 ROWS
	(nro_extrusion, long_tocho__cm, cantidad, peso_unit__kg);
CREATE TEMPORARY TABLE chk_extrusion_entrada (nro_extrusion INT, long_tocho__cm DECIMAL(4,1), cantidad INT, peso_unit__kg FLOAT);
LOAD DATA LOCAL INFILE '@@CSVFOLDER@@/extrusion.tochos.csv' INTO TABLE chk_extrusion_entrada FIELDS TERMINATED BY ',' ENCLOSED BY '"' LINES TERMINATED BY '\n' IGNORE 1 ROWS
	(nro_extrusion, long_tocho__cm, cantidad, peso_unit__kg);
SELECT 'extrusion_entrada' AS dropped_from, c.* FROM chk_extrusion_entrada c
	LEFT JOIN extrusion e ON e.nro=c.nro_extrusion WHERE e.nro IS NULL;
DROP TEMPORARY TABLE chk_extrusion_entrada;

LOAD DATA LOCAL INFILE '@@CSVFOLDER@@/extrusion.corte.csv' INTO TABLE extrusion_corte FIELDS TERMINATED BY ',' ENCLOSED BY '"' LINES TERMINATED BY '\n' IGNORE 1 ROWS
	(nro_extrusion, fecha, hora_inicio, hora_fin); # CSV never had id_rrhh_1/id_rrhh_2 (see nullability note on the table)
CREATE TEMPORARY TABLE chk_extrusion_corte (nro_extrusion INT, fecha DATE, hora_inicio TIME, hora_fin TIME);
LOAD DATA LOCAL INFILE '@@CSVFOLDER@@/extrusion.corte.csv' INTO TABLE chk_extrusion_corte FIELDS TERMINATED BY ',' ENCLOSED BY '"' LINES TERMINATED BY '\n' IGNORE 1 ROWS
	(nro_extrusion, fecha, hora_inicio, hora_fin);
SELECT 'extrusion_corte' AS dropped_from, c.* FROM chk_extrusion_corte c
	LEFT JOIN extrusion e ON e.nro=c.nro_extrusion WHERE e.nro IS NULL;
DROP TEMPORARY TABLE chk_extrusion_corte;

LOAD DATA LOCAL INFILE '@@CSVFOLDER@@/extrusion.produccion.csv' INTO TABLE extrusion_salida FIELDS TERMINATED BY ',' ENCLOSED BY '"' LINES TERMINATED BY '\n' IGNORE 1 ROWS
	(nro_extrusion, long_perfil__m, cantidad, id_tipo_contenedor, id_contenedor, @dummy1); # CSV has a trailing unused column
CREATE TEMPORARY TABLE chk_extrusion_salida (nro_extrusion INT, long_perfil__m DECIMAL(4,3), cantidad INT, id_tipo_contenedor INT, id_contenedor INT);
LOAD DATA LOCAL INFILE '@@CSVFOLDER@@/extrusion.produccion.csv' INTO TABLE chk_extrusion_salida FIELDS TERMINATED BY ',' ENCLOSED BY '"' LINES TERMINATED BY '\n' IGNORE 1 ROWS
	(nro_extrusion, long_perfil__m, cantidad, id_tipo_contenedor, id_contenedor, @dummy1);
SELECT 'extrusion_salida' AS dropped_from, c.* FROM chk_extrusion_salida c
	LEFT JOIN extrusion e ON e.nro=c.nro_extrusion WHERE e.nro IS NULL;
DROP TEMPORARY TABLE chk_extrusion_salida;

LOAD DATA LOCAL INFILE '@@CSVFOLDER@@/extrusion.muestra_culote.csv' INTO TABLE extrusion_muestraculote FIELDS TERMINATED BY ',' ENCLOSED BY '"' LINES TERMINATED BY '\n' IGNORE 1 ROWS
	(nro_extrusion, cant_culote, peso_total__kg);
CREATE TEMPORARY TABLE chk_extrusion_muestraculote (nro_extrusion INT, cant_culote INT, peso_total__kg FLOAT);
LOAD DATA LOCAL INFILE '@@CSVFOLDER@@/extrusion.muestra_culote.csv' INTO TABLE chk_extrusion_muestraculote FIELDS TERMINATED BY ',' ENCLOSED BY '"' LINES TERMINATED BY '\n' IGNORE 1 ROWS
	(nro_extrusion, cant_culote, peso_total__kg);
SELECT 'extrusion_muestraculote' AS dropped_from, c.* FROM chk_extrusion_muestraculote c
	LEFT JOIN extrusion e ON e.nro=c.nro_extrusion WHERE e.nro IS NULL;
DROP TEMPORARY TABLE chk_extrusion_muestraculote;

LOAD DATA LOCAL INFILE '@@CSVFOLDER@@/extrusion.muestra_perfil.csv' INTO TABLE extrusion_muestraperfil FIELDS TERMINATED BY ',' ENCLOSED BY '"' LINES TERMINATED BY '\n' IGNORE 1 ROWS
	(nro_extrusion, nro_salida, long_muestraperfil__cm, peso_muestra__g, @dummy1, @dummy2); # CSV has 2 trailing unused columns
CREATE TEMPORARY TABLE chk_extrusion_muestraperfil (nro_extrusion INT, nro_salida INT, long_muestraperfil__cm DECIMAL(4,1), peso_muestra__g FLOAT);
LOAD DATA LOCAL INFILE '@@CSVFOLDER@@/extrusion.muestra_perfil.csv' INTO TABLE chk_extrusion_muestraperfil FIELDS TERMINATED BY ',' ENCLOSED BY '"' LINES TERMINATED BY '\n' IGNORE 1 ROWS
	(nro_extrusion, nro_salida, long_muestraperfil__cm, peso_muestra__g, @dummy1, @dummy2);
SELECT 'extrusion_muestraperfil' AS dropped_from, c.* FROM chk_extrusion_muestraperfil c
	LEFT JOIN extrusion e ON e.nro=c.nro_extrusion WHERE e.nro IS NULL;
DROP TEMPORARY TABLE chk_extrusion_muestraperfil;

LOAD DATA LOCAL INFILE '@@CSVFOLDER@@/extrusion.stats.csv' INTO TABLE extrusion_stats FIELDS TERMINATED BY ',' ENCLOSED BY '"' LINES TERMINATED BY '\n' IGNORE 1 ROWS
	(nro_extrusion, es_prueba, pos_sierracorte, long_mesa__m, temp_tocho_entrada__c, temp_perfil_salida__c, sugiere_correccion_matriz, extrusion_detenida, comentarios);
CREATE TEMPORARY TABLE chk_extrusion_stats (nro_extrusion INT, es_prueba BOOL, pos_sierracorte FLOAT, long_mesa__m FLOAT, temp_tocho_entrada__c FLOAT, temp_perfil_salida__c FLOAT, sugiere_correccion_matriz BOOL, extrusion_detenida BOOL, comentarios TEXT);
LOAD DATA LOCAL INFILE '@@CSVFOLDER@@/extrusion.stats.csv' INTO TABLE chk_extrusion_stats FIELDS TERMINATED BY ',' ENCLOSED BY '"' LINES TERMINATED BY '\n' IGNORE 1 ROWS
	(nro_extrusion, es_prueba, pos_sierracorte, long_mesa__m, temp_tocho_entrada__c, temp_perfil_salida__c, sugiere_correccion_matriz, extrusion_detenida, comentarios);
SELECT 'extrusion_stats' AS dropped_from, c.nro_extrusion, c.comentarios FROM chk_extrusion_stats c
	LEFT JOIN extrusion e ON e.nro=c.nro_extrusion WHERE e.nro IS NULL;
DROP TEMPORARY TABLE chk_extrusion_stats;
