# op_pintura/generacion_op_pintura match check dropped: op_pintura numbering was assigned ad hoc
# and never backfilled for ~100 older orders (nro_op>160 don't exist in op_pintura at all), so
# enforcing it here silently discarded ~45% of real production rows instead of just the bad ones.
LOAD DATA LOCAL INFILE '@@CSVFOLDER@@/pintura.csv' INTO TABLE pintura FIELDS TERMINATED BY ',' ENCLOSED BY '"' LINES TERMINATED BY '\n' IGNORE 1 ROWS
	(nro,nro_op,nro_subop,id_color,fecha,hora_inicio,hora_fin,id_rrhh,velocidad_monovia,cant_porganchera,codigo,long__m,cantidad);