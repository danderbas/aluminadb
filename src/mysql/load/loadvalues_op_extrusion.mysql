LOAD DATA LOCAL INFILE '@@CSVFOLDER@@/op_extrusion.generacion.csv' INTO TABLE generacion_op_extrusion FIELDS TERMINATED BY ',' ENCLOSED BY '"' LINES TERMINATED BY '\n' IGNORE 1 ROWS
	(nro_op, fecha, id_rrhh);

LOAD DATA LOCAL INFILE '@@CSVFOLDER@@/op_extrusion.op_extrusion.csv' INTO TABLE op_extrusion FIELDS TERMINATED BY ',' ENCLOSED BY '"' LINES TERMINATED BY '\n' IGNORE 1 ROWS
	(nro_op, nro_subop, cod_perfil, long_perfil__m, cant_perfil_min, id_estado);

LOAD DATA LOCAL INFILE '@@CSVFOLDER@@/op_extrusion.entrada.csv' INTO TABLE op_extrusion_entrada FIELDS TERMINATED BY ',' ENCLOSED BY '"' LINES TERMINATED BY '\n' IGNORE 1 ROWS
	(nro_op, nro_subop, long_tocho__cm, cant_tochos, cant_tochosporcorte, posicion_sierracorte, id_proveedor_aluminio);

LOAD DATA LOCAL INFILE '@@CSVFOLDER@@/op_extrusion.matriz.csv' INTO TABLE s_op_extrusion_matriz FIELDS TERMINATED BY ',' ENCLOSED BY '"' LINES TERMINATED BY '\n' IGNORE 1 ROWS
	(nro_op, nro_subop, cod_matriz, nro_serie_matriz);

INSERT INTO op_extrusion_matriz (nro_op,nro_subop,cod_matriz,nro_serie_matriz)
	SELECT nro_op,nro_subop,cod_matriz,nro_serie_matriz FROM (
		SELECT s.*, o.nro_op AS op_ok, sm.cod_matriz AS matriz_ok,
			ROW_NUMBER() OVER (PARTITION BY s.nro_op,s.nro_subop,s.cod_matriz,s.nro_serie_matriz ORDER BY s._csv_row) AS rn
		FROM s_op_extrusion_matriz s
			LEFT JOIN op_extrusion o ON o.nro_op=s.nro_op AND o.nro_subop=s.nro_subop
			LEFT JOIN stock_matrices sm ON sm.cod_matriz=s.cod_matriz AND sm.nro_serie=s.nro_serie_matriz
	) t
	WHERE op_ok IS NOT NULL AND (nro_serie_matriz IS NULL OR matriz_ok IS NOT NULL) AND rn=1;

SELECT 'op_extrusion_matriz' AS staging_check,
	(SELECT COUNT(*) FROM s_op_extrusion_matriz) AS staged,
	(SELECT COUNT(*) FROM op_extrusion_matriz) AS loaded,
	(SELECT COUNT(*) FROM s_op_extrusion_matriz)-(SELECT COUNT(*) FROM op_extrusion_matriz) AS dropped;

SELECT s._csv_row, s.nro_op, s.nro_subop, s.cod_matriz, s.nro_serie_matriz, o.nro_op AS op_found, sm.cod_matriz AS matriz_found
	FROM s_op_extrusion_matriz s
		LEFT JOIN op_extrusion o ON o.nro_op=s.nro_op AND o.nro_subop=s.nro_subop
		LEFT JOIN stock_matrices sm ON sm.cod_matriz=s.cod_matriz AND sm.nro_serie=s.nro_serie_matriz
	WHERE o.nro_op IS NULL OR (s.nro_serie_matriz IS NOT NULL AND sm.cod_matriz IS NULL)
		OR s._csv_row NOT IN (SELECT MIN(_csv_row) FROM s_op_extrusion_matriz GROUP BY nro_op,nro_subop,cod_matriz,nro_serie_matriz);

LOAD DATA LOCAL INFILE '@@CSVFOLDER@@/op_extrusion.objetivo.csv' INTO TABLE op_extrusion_objetivo FIELDS TERMINATED BY ',' ENCLOSED BY '"' LINES TERMINATED BY '\n' IGNORE 1 ROWS
	(nro_op, nro_subop, long_mesa_objetivo__m, cant_perfil_objetivo, salida_objetivo__kg);

LOAD DATA LOCAL INFILE '@@CSVFOLDER@@/op_extrusion.parapedido.csv' INTO TABLE s_op_extrusion_parapedido FIELDS TERMINATED BY ',' ENCLOSED BY '"' LINES TERMINATED BY '\n' IGNORE 1 ROWS
	(nro_op, nro_subop, nro_pedido, nro_subpedido);
INSERT INTO op_extrusion_parapedido (nro_op,nro_subop,nro_pedido,nro_subpedido)
	SELECT nro_op,nro_subop,nro_pedido,nro_subpedido FROM (
		SELECT s.*, o.cod_perfil AS op_cod_perfil, p.codigo AS pedido_codigo,
			ROW_NUMBER() OVER (PARTITION BY s.nro_op,s.nro_subop,s.nro_pedido,s.nro_subpedido ORDER BY s._csv_row) AS rn
		FROM s_op_extrusion_parapedido s
			LEFT JOIN op_extrusion o ON o.nro_op=s.nro_op AND o.nro_subop=s.nro_subop
			LEFT JOIN pedidos p ON p.nro_pedido=s.nro_pedido AND p.nro_subpedido=s.nro_subpedido
	) t
	WHERE op_cod_perfil IS NOT NULL AND pedido_codigo IS NOT NULL AND op_cod_perfil=pedido_codigo AND rn=1;
SELECT 'op_extrusion_parapedido' AS staging_check,
	(SELECT COUNT(*) FROM s_op_extrusion_parapedido) AS staged,
	(SELECT COUNT(*) FROM op_extrusion_parapedido) AS loaded,
	(SELECT COUNT(*) FROM s_op_extrusion_parapedido)-(SELECT COUNT(*) FROM op_extrusion_parapedido) AS dropped;
-- which staged rows were dropped, and why
SELECT s._csv_row, s.nro_op, s.nro_subop, s.nro_pedido, s.nro_subpedido,
		o.cod_perfil AS op_cod_perfil, p.codigo AS pedido_codigo
	FROM s_op_extrusion_parapedido s
	LEFT JOIN op_extrusion o ON o.nro_op=s.nro_op AND o.nro_subop=s.nro_subop
	LEFT JOIN pedidos p ON p.nro_pedido=s.nro_pedido AND p.nro_subpedido=s.nro_subpedido
	WHERE o.nro_op IS NULL OR p.nro_pedido IS NULL OR p.codigo IS NULL OR o.cod_perfil <> p.codigo
		OR s._csv_row NOT IN (SELECT MIN(_csv_row) FROM s_op_extrusion_parapedido GROUP BY nro_op,nro_subop,nro_pedido,nro_subpedido);

LOAD DATA LOCAL INFILE '@@CSVFOLDER@@/op_extrusion.planeamiento.csv' INTO TABLE op_extrusion_planeamiento FIELDS TERMINATED BY ',' ENCLOSED BY '"' LINES TERMINATED BY '\n' IGNORE 1 ROWS
	(nro_op, nro_subop, fraccion_entrada, fecha_planeada, orden);
