{"version": 2, "width": 80, "height": 24, "timestamp": 1786833881, "env": {"SHELL": "/bin/bash", "TERM": "linux"}}
[0.069407, "o", "\u001b[1A\u001b[1B\u001b[0G\u001b[?25l[+] Creating 1/0\r\n \u001b[32m✔\u001b[0m Container aluminadb-mysql  \u001b[32mRunning\u001b[0m                                      \u001b[34m0.0s \u001b[0m\r\n\u001b[?25h"]
[0.533435, "o", "============================================================\r\n"]
[0.534841, "o", "  ALUMINADB -- NITRIDING DUE LIST\r\n"]
[0.53644, "o", "============================================================\r\n"]
[2.541244, "o", "\r\n"]
[2.542732, "o", "------------------------------------------------------------\r\n"]
[2.544386, "o", " Which dies need nitriding -- yes or no, which ones?\r\n"]
[2.546159, "o", "------------------------------------------------------------\r\n"]
[2.547483, "o", "matrices_nitruracion_v already tracks kg extruded since\r\n"]
[2.548755, "o", "each die's last nitriding. nitruracion_kgmax has the limit,\r\n"]
[2.549962, "o", "which depends on the die's fragility -- that's the one join\r\n"]
[2.551275, "o", "the view doesn't do for you:\r\n"]
[4.554016, "o", "--------------\r\nSELECT\r\n    CONCAT(v.cod_matriz, '/', v.nro_serie_matriz) AS matriz,\r\n    m.es_fragil,\r\n    v.nro_nitruraciones AS nro_nit,\r\n    ROUND(v.entdsdultnit__kg) AS kg_desde_ult_nit,\r\n    k.max__kg,\r\n    ROUND(100 * v.entdsdultnit__kg / k.max__kg, 1) AS pct_of_max\r\nFROM matrices_nitruracion_v v\r\nJOIN stock_matrices sm ON sm.cod_matriz = v.cod_matriz AND sm.nro_serie = v.nro_serie_matriz\r\nJOIN matrices m ON m.codigo = v.cod_matriz\r\nLEFT JOIN nitruracion_kgmax k\r\n    ON k.nro_nitruraciones = v.nro_nitruraciones AND k.es_fragil = m.es_fragil\r\nORDER BY pct_of_max DESC\r\nLIMIT 10\r\n--------------\r\n\r\n"]
[4.560608, "o", "+------------+-----------+---------+------------------+---------+------------+\r\n| matriz     | es_fragil | nro_nit | kg_desde_ult_nit | max__kg | pct_of_max |\r\n+------------+-----------+---------+------------------+---------+------------+\r\n| DIE-0009/1 |         0 |       2 |             1449 |    2000 |       72.5 |\r\n| DIE-0005/2 |         0 |       1 |              684 |    1000 |       68.4 |\r\n| DIE-0022/1 |         0 |       1 |              655 |    1000 |       65.5 |\r\n| DIE-0035/1 |         0 |       2 |             1310 |    2000 |       65.5 |\r\n| DIE-0061/1 |         0 |       1 |              606 |    1000 |       60.6 |\r\n| DIE-0070/1 |         1 |       3 |             1783 |    3000 |       59.4 |\r\n| DIE-0044/1 |         0 |       1 |              586 |    1000 |       58.6 |\r\n| DIE-0006/1 |         0 |       3 |             2321 |    4000 |         58 |\r\n| DIE-0063/1 |         1 |       2 |              816 |    1500 |       54.4 |\r\n| DIE-0091/1 |         0 |       1 |              543 |    1000 |       54.3 |\r\n+------------+-----------+---------+------------------+---------+------------+\r\n10 rows in set\r\n\r\n"]
[7.564106, "o", "\r\n"]
[7.565479, "o", "Nothing's over its limit right now -- DIE-0009/1 at 72.5%\r\n"]
[7.566663, "o", "is closest, worth queuing for the next nitriding batch\r\n"]
[7.567721, "o", "before it gets there.\r\n"]
[10.571164, "o", "Bye\r\n"]
