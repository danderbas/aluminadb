[3.737229, "o", "Query OK, 582 rows affected\r\nRecords: 582  Deleted: 0  Skipped: 0  Warnings: 0\r\n\r\n--------------\r\nINSERT INTO extrusion (nro,fecha,hora_inicio,hora_fin,id_rrhh,nro_op,nro_subop,cod_perfil)\r\n\tSELECT nro,fecha,hora_inicio,hora_fin,id_rrhh,nro_op,nro_subop,cod_perfil FROM (\r\n\t\tSELECT s.*, o.cod_perfil AS op_cod_perfil, p.codigo AS perfil_ok, r.id AS rrhh_ok,\r\n\t\t\tROW_NUMBER() OVER (PARTITION BY s.fecha,s.hora_inicio,s.hora_fin ORDER BY s._csv_row) AS rn\r\n\t\tFROM s_extrusion s\r\n\t\t\tLEFT JOIN op_extrusion o ON o.nro_op=s.nro_op AND o.nro_subop=s.nro_subop\r\n\t\t\tLEFT JOIN perfiles p ON p.codigo=s.cod_perfil\r\n\t\t\tLEFT JOIN rrhh r ON r.id=s.id_rrhh\r\n\t) t\r\n\tWHERE (nro_op IS NULL OR nro_subop IS NULL OR op_cod_perfil=cod_perfil)\r\n\t\tAND perfil_ok IS NOT NULL\r\n\t\tAND (id_rrhh IS NULL OR rrhh_ok IS NOT NULL)\r\n\t\tAND NOT (nro_op IS NULL AND nro_subop IS NULL AND cod_perfil IS NULL)\r\n\t\tAND (TIME_TO_SEC(TIMEDIFF(hora_fin,hora_inicio))/3600 < 3.5) IS NOT FALSE\r\n\t\tAND rn = 1\r\n--------------\r\n\r\n"]
