[3.886593, "o", "Query OK, 581 rows affected\r\nRecords: 581  Deleted: 0  Skipped: 0  Warnings: 0\r\n\r\n--------------\r\nINSERT INTO extrusion_matriz (nro_extrusion,cod_matriz,nro_serie_matriz)\r\n\tSELECT nro_extrusion,cod_matriz,nro_serie_matriz FROM (\r\n\t\tSELECT s.*, e.cod_perfil AS extrusion_cod_perfil, m.cod_perfil AS matriz_cod_perfil,\r\n\t\t\tROW_NUMBER() OVER (PARTITION BY s.nro_extrusion ORDER BY s._csv_row) AS rn\r\n\t\tFROM s_extrusion_matriz s\r\n\t\t\tLEFT JOIN extrusion e ON e.nro=s.nro_extrusion\r\n\t\t\tLEFT JOIN matrices m ON m.codigo=s.cod_matriz\r\n\t) t\r\n\tWHERE extrusion_cod_perfil IS NOT NULL AND matriz_cod_perfil IS NOT NULL\r\n\t\tAND extrusion_cod_perfil=matriz_cod_perfil AND rn=1\r\n--------------\r\n\r\n"]
