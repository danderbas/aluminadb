[3.417195, "o", "Query OK, 849 rows affected\r\nRecords: 849  Deleted: 0  Skipped: 0  Warnings: 0\r\n\r\n--------------\r\nINSERT INTO cortetochos (nro,nro_op,nro_subop,fecha,hora_inicio,hora_fin,id_rrhh,nro_tocho0,long_inicial__cm,long_tocho__cm,cant_tochos,pesoprom_tochos__kg,long_final__cm,peso_resto__kg)\r\n\tSELECT nro,nro_op,nro_subop,fecha,hora_inicio,hora_fin,id_rrhh,nro_tocho0,long_inicial__cm,long_tocho__cm,cant_tochos,pesoprom_tochos__kg,long_final__cm,peso_resto__kg FROM (\r\n\t\tSELECT s.*, t0.nro AS tocho0_ok, o.nro_op AS op_ok, r.id AS rrhh_ok,\r\n\t\t\tROW_NUMBER() OVER (PARTITION BY s.nro_tocho0,s.long_inicial__cm ORDER BY s._csv_row) AS rn\r\n\t\tFROM s_cortetochos s\r\n\t\t\tLEFT JOIN tocho0 t0 ON t0.nro=s.nro_tocho0\r\n\t\t\tLEFT JOIN op_extrusion o ON o.nro_op=s.nro_op AND o.nro_subop=s.nro_subop\r\n\t\t\tLEFT JOIN rrhh r ON r.id=s.id_rrhh\r\n\t) t\r\n\tWHERE (nro_tocho0 IS NULL OR tocho0_ok IS NOT NULL)\r\n\t\tAND (nro_op IS NULL OR nro_subop IS NULL OR op_ok IS NOT NULL)\r\n\t\tAND (id_rrhh IS NULL OR rrhh_ok IS NOT NULL)\r\n\t\tAND cant_tochos > 0\r\n\t\tAND (nro_tocho0 IS NULL OR long_inicial__cm IS NULL OR rn=1)\r\n--------------\r\n\r\n"]
