[5.069223, "o", "Query OK, 359 rows affected\r\nRecords: 359  Deleted: 0  Skipped: 0  Warnings: 0\r\n\r\n--------------\r\nINSERT INTO envejecimiento_canastos (nro_canasto,nro_envejecimiento,id_tipo_contenedor,id_contenedor)\r\n\tSELECT nro_canasto,nro_envejecimiento,id_tipo_contenedor,id_contenedor FROM (\r\n\t\tSELECT s.*, e.nro AS envejecimiento_ok, c.id_tipo_contenedor AS contenedor_ok,\r\n\t\t\tROW_NUMBER() OVER (PARTITION BY s.nro_canasto,s.nro_envejecimiento ORDER BY s._csv_row) AS rn\r\n\t\tFROM s_envejecimiento_canastos s\r\n\t\t\tLEFT JOIN envejecimiento e ON e.nro=s.nro_envejecimiento\r\n\t\t\tLEFT JOIN stock_contenedores_perfiles c ON c.id_tipo_contenedor=s.id_tipo_contenedor AND c.id_contenedor=s.id_contenedor\r\n\t) t\r\n\tWHERE envejecimiento_ok IS NOT NULL AND contenedor_ok IS NOT NULL\r\n\t\tAND (id_tipo_contenedor=1 OR (id_tipo_contenedor=0 AND id_contenedor=0))\r\n\t\tAND rn=1\r\n--------------\r\n\r\n"]
[5.107698, "o", "Query OK, 358 rows affected\r\nRecords: 358  Duplicates: 0  Warnings: 0\r\n\r\n--------------\r\nSELECT 'envejecimiento_canastos' AS staging_check,\r\n\t(SELECT COUNT(*) FROM s_envejecimiento_canastos) AS staged,\r\n\t(SELECT COUNT(*) FROM envejecimiento_canastos) AS loaded,\r\n\t(SELECT COUNT(*) FROM s_envejecimiento_canastos)-(SELECT COUNT(*) FROM envejecimiento_canastos) AS dropped\r\n--------------\r\n\r\n"]
[5.108927, "o", "staging_check\tstaged\tloaded\tdropped\r\nenvejecimiento_canastos\t359\t358\t1\r\n1 row in set\r\n\r\n--------------\r\nSELECT s._csv_row, s.nro_canasto, s.nro_envejecimiento, s.id_tipo_contenedor, s.id_contenedor,\r\n\t\te.nro AS envejecimiento_found, c.id_tipo_contenedor AS contenedor_found\r\n\tFROM s_envejecimiento_canastos s\r\n\t\tLEFT JOIN envejecimiento e ON e.nro=s.nro_envejecimiento\r\n\t\tLEFT JOIN stock_contenedores_perfiles c ON c.id_tipo_contenedor=s.id_tipo_contenedor AND c.id_contenedor=s.id_contenedor\r\n\tWHERE e.nro IS NULL OR c.id_tipo_contenedor IS NULL\r\n\t\tOR NOT (s.id_tipo_contenedor=1 OR (s.id_tipo_contenedor=0 AND s.id_contenedor=0))\r\n\t\tOR s._csv_row NOT IN (SELECT MIN(_csv_row) FROM s_envejecimiento_canastos GROUP BY nro_canasto,nro_envejecimiento)\r\n--------------\r\n\r\n"]
[5.110493, "o", "_csv_row\tnro_canasto\tnro_envejecimiento\tid_tipo_contenedor\tid_contenedor\tenvejecimiento_found\tcontenedor_found\r\n342\t333\t90\t1\t2\t90\t1\r\n1 row in set\r\n\r\n--------------\r\nLOAD DATA LOCAL INFILE '/workspace/data/csv/envejecimiento.contenido.csv' INTO TABLE s_envejecimiento_canastos_detalle FIELDS TERMINATED BY ',' ENCLOSED BY '\"' LINES TERMINATED BY '\\n' IGNORE 1 ROWS\r\n\t(nro_canasto, cod_perfil, long_perfil__m, cantidad, nro_op, nro_subop, @dummy1, @dummy2)\r\n--------------\r\n\r\n"]
[5.19905, "o", "Query OK, 1233 rows affected\r\nRecords: 1233  Deleted: 0  Skipped: 0  Warnings: 0\r\n\r\n--------------\r\nINSERT INTO envejecimiento_canastos_detalle (nro_canasto,cod_perfil,long_perfil__m,cantidad,nro_op,nro_subop)\r\n\tSELECT nro_canasto,cod_perfil,long_perfil__m,cantidad,nro_op,nro_subop FROM (\r\n\t\tSELECT s.*,\r\n\t\t\t(SELECT MIN(c.nro_canasto) FROM envejecimiento_canastos c WHERE c.nro_canasto=s.nro_canasto) AS canasto_ok,\r\n\t\t\tp.codigo AS perfil_ok, o.nro_op AS op_ok,\r\n\t\t\tROW_NUMBER() OVER (PARTITION BY s.nro_canasto,s.cod_perfil,s.long_perfil__m,s.nro_op,s.nro_subop,s.cantidad ORDER BY s._csv_row) AS rn\r\n\t\tFROM s_envejecimiento_canastos_detalle s\r\n\t\t\tLEFT JOIN perfiles p ON p.codigo=s.cod_perfil\r\n\t\t\tLEFT JOIN op_extrusion o ON o.nro_op=s.nro_op AND o.nro_subop=s.nro_subop\r\n\t) t\r\n\tWHERE canasto_ok IS NOT NULL AND perfil_ok IS NOT NULL\r\n\t\tAND (nro_op IS NULL OR nro_subop IS NULL OR op_ok IS NOT NULL)\r\n\t\tAND long_perfil__m > 0 AND cantidad > 0 AND rn=1\r\n--------------\r\n\r\n"]
[5.471147, "o", "Query OK, 1223 rows affected\r\nRecords: 1223  Duplicates: 0  Warnings: 0\r\n\r\n--------------\r\nSELECT 'envejecimiento_canastos_detalle' AS staging_check,\r\n\t(SELECT COUNT(*) FROM s_envejecimiento_canastos_detalle) AS staged,\r\n\t(SELECT COUNT(*) FROM envejecimiento_canastos_detalle) AS loaded,\r\n\t(SELECT COUNT(*) FROM s_envejecimiento_canastos_detalle)-(SELECT COUNT(*) FROM envejecimiento_canastos_detalle) AS dropped\r\n--------------\r\n\r\n"]
[5.473874, "o", "staging_check\tstaged\tloaded\tdropped\r\nenvejecimiento_canastos_detalle\t1233\t1223\t10\r\n1 row in set\r\n\r\n--------------\r\nSELECT s._csv_row, s.nro_canasto, s.cod_perfil, s.long_perfil__m, s.cantidad, s.nro_op, s.nro_subop,\r\n\t\t(SELECT MIN(c.nro_canasto) FROM envejecimiento_canastos c WHERE c.nro_canasto=s.nro_canasto) AS canasto_found,\r\n\t\tp.codigo AS perfil_found, o.nro_op AS op_found\r\n\tFROM s_envejecimiento_canastos_detalle s\r\n\t\tLEFT JOIN perfiles p ON p.codigo=s.cod_perfil\r\n\t\tLEFT JOIN op_extrusion o ON o.nro_op=s.nro_op AND o.nro_subop=s.nro_subop\r\n\tWHERE NOT EXISTS (SELECT 1 FROM envejecimiento_canastos c WHERE c.nro_canasto=s.nro_canasto) OR p.codigo IS NULL\r\n\t\tOR (s.nro_op IS NOT NULL AND s.nro_subop IS NOT NULL AND o.nro_op IS NULL)\r\n\t\tOR s.long_perfil__m <= 0 OR s.cantidad <= 0\r\n\t\tOR s._csv_row NOT IN (SELECT MIN(_csv_row) FROM s_envejecimiento_canastos_detalle GROUP BY nro_canasto,cod_perfil,long_perfil__m,nro_op,nro_subop,cantidad)\r\n--------------\r\n\r\n"]
