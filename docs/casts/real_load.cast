[1.899629, "o", "Query OK, 884 rows affected\r\nRecords: 884  Deleted: 0  Skipped: 0  Warnings: 0\r\n\r\n--------------\r\nINSERT INTO pedidos (nro_pedido,nro_subpedido,id_tipo_pedido,es_recibidoparapintar,codigo,long__m,id_tipo_acabado,id_color,cantidad,id_prioridad,id_estado)\r\n\tSELECT nro_pedido,nro_subpedido,id_tipo_pedido,es_recibidoparapintar,codigo,long__m,id_tipo_acabado,id_color,cantidad,id_prioridad,id_estado FROM (\r\n\t\tSELECT s.*, gp.nro_pedido AS pedido_ok, p.codigo AS perfil_ok, tp.id AS tipo_pedido_ok,\r\n\t\t\tta.id AS tipo_acabado_ok, c.id AS color_ok, ep.id AS estado_ok,\r\n\t\t\tROW_NUMBER() OVER (PARTITION BY s.nro_pedido,s.nro_subpedido ORDER BY s._csv_row) AS rn\r\n\t\tFROM s_pedidos s\r\n\t\t\tLEFT JOIN generacion_pedidos gp ON gp.nro_pedido=s.nro_pedido\r\n\t\t\tLEFT JOIN perfiles p ON p.codigo=s.codigo\r\n\t\t\tLEFT JOIN tipos_pedidos tp ON tp.id=s.id_tipo_pedido\r\n\t\t\tLEFT JOIN tipos_acabado ta ON ta.id=s.id_tipo_acabado\r\n\t\t\tLEFT JOIN colores c ON c.id=s.id_color\r\n\t\t\tLEFT JOIN estados_pedidos ep ON ep.id=s.id_estado\r\n\t) t\r\n\tWHERE pedido_ok IS NOT NULL\r\n\t\tAND (codigo IS NULL OR perfil_ok IS NOT NULL)\r\n\t\tAND tipo_pedido_ok IS NOT NULL AND tipo_acabado_ok IS NOT NULL AND color_ok IS NOT NULL AND estado_ok IS NOT NULL\r\n\t\tAND NOT (id_tipo_pedido > 0 AND long__m IS NULL)\r\n\t\tAND NOT (id_tipo_acabado=1 AND id_color=0)\r\n\t\tAND (0 < long__m AND long__m < 8) IS NOT FALSE\r\n\t\tAND rn=1\r\n--------------\r\n\r\n"]
