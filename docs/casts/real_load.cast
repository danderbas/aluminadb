[3.830729, "o", "--------------\r\nSELECT s._csv_row, s.nro, s.fecha, s.hora_inicio, s.hora_fin, s.id_rrhh, s.nro_op, s.nro_subop, s.cod_perfil,\r\n\t\to.cod_perfil AS op_cod_perfil, p.codigo AS perfil_found, r.id AS rrhh_found\r\n\tFROM s_extrusion s\r\n\t\tLEFT JOIN op_extrusion o ON o.nro_op=s.nro_op AND o.nro_subop=s.nro_subop\r\n\t\tLEFT JOIN perfiles p ON p.codigo=s.cod_perfil\r\n\t\tLEFT JOIN rrhh r ON r.id=s.id_rrhh\r\n\tWHERE s._csv_row NOT IN (\r\n\t\tSELECT _csv_row FROM (\r\n\t\t\tSELECT s2._csv_row, o2.cod_perfil AS op_cod_perfil, p2.codigo AS perfil_ok, r2.id AS rrhh_ok,\r\n\t\t\t\tROW_NUMBER() OVER (PARTITION BY s2.fecha,s2.hora_inicio,s2.hora_fin ORDER BY s2._csv_row) AS rn\r\n\t\t\tFROM s_extrusion s2\r\n\t\t\t\tLEFT JOIN op_extrusion o2 ON o2.nro_op=s2.nro_op AND o2.nro_subop=s2.nro_subop\r\n\t\t\t\tLEFT JOIN perfiles p2 ON p2.codigo=s2.cod_perfil\r\n\t\t\t\tLEFT JOIN rrhh r2 ON r2.id=s2.id_rrhh\r\n\t\t) t2\r\n\t\tWHERE (t2.op_cod_perfil=s.cod_perfil OR s.nro_op IS NULL OR s.nro_subop IS NULL)\r\n\t\t\tAND t2.perfil_ok IS NOT NULL AND (s.id_rrhh IS NULL OR t2.rrhh_ok IS NOT NULL)\r\n\t\t\tAND NOT (s.nro_op IS NULL AND s.nro_subop IS NULL AND s.cod_perfil IS NULL)\r\n\t\t\tAND (TIME_TO_SEC(TIMEDIFF(s.hora_fin,s.hora_inicio))/3600 < 3.5) IS NOT FALSE\r\n\t\t\tAND t2.rn = 1\r\n\t)\r\n--------------\r\n\r\n"]
