[1.112799, "o", "Query OK, 403 rows affected\r\nRecords: 403  Deleted: 0  Skipped: 0  Warnings: 0\r\n\r\n--------------\r\nINSERT INTO pinturas (nro_caja,nro_carga,nro_subcarga)\r\n\tSELECT nro_caja,nro_carga,nro_subcarga FROM (\r\n\t\tSELECT s.*, cpd.nro_carga AS carga_ok,\r\n\t\t\tROW_NUMBER() OVER (PARTITION BY s.nro_caja ORDER BY s._csv_row) AS rn\r\n\t\tFROM s_pinturas s\r\n\t\t\tLEFT JOIN cargas_pinturas_detalle cpd ON cpd.nro_carga=s.nro_carga AND cpd.nro_subcarga=s.nro_subcarga\r\n\t) t\r\n\tWHERE (nro_carga IS NULL OR nro_subcarga IS NULL OR carga_ok IS NOT NULL) AND rn=1\r\n--------------\r\n\r\n"]
