[4.320869, "o", "Query OK, 1257 rows affected\r\nRecords: 1257  Deleted: 0  Skipped: 0  Warnings: 0\r\n\r\n--------------\r\nINSERT INTO extrusion_salida (nro_extrusion,long_perfil__m,cantidad,id_tipo_contenedor,id_contenedor)\r\n\tSELECT nro_extrusion,long_perfil__m,cantidad,id_tipo_contenedor,id_contenedor FROM (\r\n\t\tSELECT s.*, e.nro AS extrusion_ok, c.id_tipo_contenedor AS contenedor_ok,\r\n\t\t\tROW_NUMBER() OVER (PARTITION BY s.nro_extrusion,s.long_perfil__m,s.cantidad,s.id_tipo_contenedor,s.id_contenedor ORDER BY s._csv_row) AS rn\r\n\t\tFROM s_extrusion_salida s\r\n\t\t\tLEFT JOIN extrusion e ON e.nro=s.nro_extrusion\r\n\t\t\tLEFT JOIN stock_contenedores_perfiles c ON c.id_tipo_contenedor=s.id_tipo_contenedor AND c.id_contenedor=s.id_contenedor\r\n\t) t\r\n\tWHERE extrusion_ok IS NOT NULL AND (id_contenedor IS NULL OR contenedor_ok IS NOT NULL) AND cantidad > 0 AND rn=1\r\n--------------\r\n\r\n"]
