[4.004544, "o", "Query OK, 723 rows affected\r\nRecords: 723  Deleted: 0  Skipped: 0  Warnings: 0\r\n\r\n--------------\r\nINSERT INTO extrusion_entrada (nro_extrusion,long_tocho__cm,peso_unit__kg,cantidad)\r\n\tSELECT nro_extrusion,long_tocho__cm,peso_unit__kg,cantidad FROM (\r\n\t\tSELECT s.*, e.nro AS extrusion_ok,\r\n\t\t\tROW_NUMBER() OVER (PARTITION BY s.nro_extrusion,s.long_tocho__cm,s.cantidad,s.peso_unit__kg ORDER BY s._csv_row) AS rn\r\n\t\tFROM s_extrusion_entrada s\r\n\t\t\tLEFT JOIN extrusion e ON e.nro=s.nro_extrusion\r\n\t) t\r\n\tWHERE extrusion_ok IS NOT NULL AND 0 < long_tocho__cm AND long_tocho__cm <= 80 AND cantidad > 0 AND rn=1\r\n--------------\r\n\r\n"]
