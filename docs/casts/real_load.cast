[5.524195, "o", "--------------\r\nLOAD DATA LOCAL INFILE '/workspace/data/csv/d_stock_perfiles.csv' INTO TABLE d_stock_perfiles FIELDS TERMINATED BY ',' ENCLOSED BY '\"' LINES TERMINATED BY '\\n' IGNORE 1 ROWS\r\n\t(id, fecha, hora, id_rrhh, id_tipo_contenedor_origen, id_contenedor_origen, id_tipo_contenedor_destino, id_contenedor_destino, cod_perfil, long_perfil__m, es_envejecido, id_tipo_acabado, id_color, es_defectuoso, cantidad, nro_extrusion, nro_envejecimiento, nro_pintura, id_impresion_etiq, comentario, es_fix, @ok_unused)\r\n--------------\r\n\r\n"]
[5.606254, "o", "Query OK, 395 rows affected\r\nRecords: 395  Deleted: 0  Skipped: 0  Warnings: 0\r\n\r\n--------------\r\nINSERT INTO stock_perfiles (id_tipo_contenedor, id_contenedor, cod_perfil, long_perfil__m, es_envejecido, id_tipo_acabado, id_color, es_defectuoso, cantidad)\r\nSELECT id_tipo_contenedor, id_contenedor, cod_perfil, long_perfil__m, es_envejecido, id_tipo_acabado, id_color, es_defectuoso, SUM(delta)\r\nFROM (\r\n\tSELECT id_tipo_contenedor_destino AS id_tipo_contenedor, id_contenedor_destino AS id_contenedor,\r\n\t\tcod_perfil, long_perfil__m, es_envejecido, id_tipo_acabado, id_color, es_defectuoso, cantidad AS delta\r\n\tFROM d_stock_perfiles WHERE id_contenedor_destino IS NOT NULL\r\n\tUNION ALL\r\n\tSELECT id_tipo_contenedor_origen AS id_tipo_contenedor, id_contenedor_origen AS id_contenedor,\r\n\t\tcod_perfil, long_perfil__m, es_envejecido, id_tipo_acabado, id_color, es_defectuoso, -cantidad AS delta\r\n\tFROM d_stock_perfiles WHERE id_contenedor_origen IS NOT NULL\r\n) movements\r\nGROUP BY id_tipo_contenedor, id_contenedor, cod_perfil, long_perfil__m, es_envejecido, id_tipo_acabado, id_color, es_defectuoso\r\nHAVING SUM(delta) > 0\r\n--------------\r\n\r\n"]
