[1.681258, "o", "Query OK, 202 rows affected\r\nRecords: 202  Deleted: 0  Skipped: 0  Warnings: 0\r\n\r\n--------------\r\nINSERT INTO matrices_nitruracion (fecha_salida,fecha_retorno,id_rrhh_salida,id_rrhh_retorno,cod_matriz,nro_serie_matriz)\r\n\tSELECT fecha_salida,fecha_retorno,id_rrhh_salida,id_rrhh_retorno,cod_matriz,nro_serie_matriz FROM (\r\n\t\tSELECT s.*, sm.cod_matriz AS matriz_ok, r1.id AS rrhh_salida_ok, r2.id AS rrhh_retorno_ok,\r\n\t\t\tROW_NUMBER() OVER (PARTITION BY s.fecha_salida,s.cod_matriz,s.nro_serie_matriz ORDER BY s._csv_row) AS rn_salida,\r\n\t\t\tROW_NUMBER() OVER (PARTITION BY s.fecha_retorno,s.cod_matriz,s.nro_serie_matriz ORDER BY s._csv_row) AS rn_retorno\r\n\t\tFROM s_matrices_nitruracion s\r\n\t\t\tLEFT JOIN stock_matrices sm ON sm.cod_matriz=s.cod_matriz AND sm.nro_serie=s.nro_serie_matriz\r\n\t\t\tLEFT JOIN rrhh r1 ON r1.id=s.id_rrhh_salida\r\n\t\t\tLEFT JOIN rrhh r2 ON r2.id=s.id_rrhh_retorno\r\n\t) t\r\n\tWHERE matriz_ok IS NOT NULL AND rrhh_salida_ok IS NOT NULL\r\n\t\tAND (id_rrhh_retorno IS NULL OR rrhh_retorno_ok IS NOT NULL)\r\n\t\tAND (fecha_retorno IS NULL OR fecha_salida <= fecha_retorno)\r\n\t\tAND rn_salida=1\r\n\t\tAND (fecha_retorno IS NULL OR rn_retorno=1)\r\n--------------\r\n\r\n"]
[1.719862, "o", "Query OK, 200 rows affected\r\nRecords: 200  Duplicates: 0  Warnings: 0\r\n\r\n--------------\r\nSELECT 'matrices_nitruracion' AS staging_check,\r\n\t(SELECT COUNT(*) FROM s_matrices_nitruracion) AS staged,\r\n\t(SELECT COUNT(*) FROM matrices_nitruracion) AS loaded,\r\n\t(SELECT COUNT(*) FROM s_matrices_nitruracion)-(SELECT COUNT(*) FROM matrices_nitruracion) AS dropped\r\n--------------\r\n\r\n"]
[1.721299, "o", "staging_check\tstaged\tloaded\tdropped\r\nmatrices_nitruracion\t202\t200\t2\r\n1 row in set\r\n\r\n--------------\r\nSELECT s._csv_row, s.fecha_salida, s.fecha_retorno, s.id_rrhh_salida, s.id_rrhh_retorno, s.cod_matriz, s.nro_serie_matriz,\r\n\t\tsm.cod_matriz AS matriz_found, r1.id AS rrhh_salida_found, r2.id AS rrhh_retorno_found\r\n\tFROM s_matrices_nitruracion s\r\n\t\tLEFT JOIN stock_matrices sm ON sm.cod_matriz=s.cod_matriz AND sm.nro_serie=s.nro_serie_matriz\r\n\t\tLEFT JOIN rrhh r1 ON r1.id=s.id_rrhh_salida\r\n\t\tLEFT JOIN rrhh r2 ON r2.id=s.id_rrhh_retorno\r\n\tWHERE sm.cod_matriz IS NULL OR r1.id IS NULL OR (s.id_rrhh_retorno IS NOT NULL AND r2.id IS NULL)\r\n\t\tOR (s.fecha_retorno IS NOT NULL AND s.fecha_salida > s.fecha_retorno)\r\n\t\tOR s._csv_row NOT IN (SELECT MIN(_csv_row) FROM s_matrices_nitruracion GROUP BY fecha_salida,cod_matriz,nro_serie_matriz)\r\n\t\tOR (s.fecha_retorno IS NOT NULL AND s._csv_row NOT IN (SELECT MIN(_csv_row) FROM s_matrices_nitruracion WHERE fecha_retorno IS NOT NULL GROUP BY fecha_retorno,cod_matriz,nro_serie_matriz))\r\n--------------\r\n\r\n"]
