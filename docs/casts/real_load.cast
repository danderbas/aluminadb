[4.918906, "o", "Query OK, 582 rows affected\r\nRecords: 582  Deleted: 0  Skipped: 0  Warnings: 0\r\n\r\n--------------\r\nINSERT INTO extrusion_stats (nro_extrusion,es_prueba,pos_sierracorte,long_mesa__m,temp_tocho_entrada__c,temp_perfil_salida__c,sugiere_correccion_matriz,extrusion_detenida,comentarios)\r\n\tSELECT nro_extrusion,es_prueba,pos_sierracorte,long_mesa__m,temp_tocho_entrada__c,temp_perfil_salida__c,sugiere_correccion_matriz,extrusion_detenida,comentarios FROM (\r\n\t\tSELECT s.*, e.nro AS extrusion_ok,\r\n\t\t\tROW_NUMBER() OVER (PARTITION BY s.nro_extrusion ORDER BY s._csv_row) AS rn\r\n\t\tFROM s_extrusion_stats s\r\n\t\t\tLEFT JOIN extrusion e ON e.nro=s.nro_extrusion\r\n\t) t\r\n\tWHERE extrusion_ok IS NOT NULL AND ((extrusion_detenida AND comentarios IS NOT NULL) OR NOT extrusion_detenida) AND rn=1\r\n--------------\r\n\r\n"]
