[19.875519, "o", "--------------\r\nCREATE PROCEDURE infomatrizp (IN curr_cod_matriz VARCHAR(30), IN curr_nro_serie_matriz INT)\r\nBEGIN\r\n\tSELECT\r\n\t\tmatrices.codigo,\r\n\t\tnro_serie_matriz,\r\n\t\tmatrices.id_tipo,\r\n\t\tnro_salidas,\r\n\t\tes_fragil,\r\n\t\textrusion_matriz.nro_extrusion,\r\n\t\tCAST(avgpesolineal AS DECIMAL(4,3)) avg_PL,\r\n\t\tCAST(100*(avgpesolineal/perfiles.pesolinealnominal__kg_m-1) AS DECIMAL(4,3)) dif_porc_PL\r\n\tFROM matrices\r\n\t\tJOIN extrusion_matriz\r\n\t\t\tON matrices.codigo=extrusion_matriz.cod_matriz\r\n\t\tJOIN extrusion_pesolineal_v\r\n\t\t\tON extrusion_matriz.nro_extrusion=extrusion_pesolineal_v.nro_extrusion \r\n\t\tJOIN perfiles\r\n\t\t\tON perfiles.codigo=matrices.cod_perfil\r\n\tWHERE matrices.codigo LIKE curr_cod_matriz AND nro_serie_matriz=curr_nro_serie_matriz;\r\nEND\r\n--------------\r\n\r\n"]
[19.91119, "o", "Query OK, 0 rows affected\r\n\r\n--------------\r\nCREATE PROCEDURE infomatriz (IN curr_cod_matriz VARCHAR(30), IN curr_nro_serie_matriz INT, OUT nro_nitruraciones_out INT, OUT kg_dsdultnit_out FLOAT)\r\nBEGIN\r\n\tSET @maxvalue_max__kg = (SELECT max(max__kg) FROM nitruracion_kgmax JOIN matrices ON nitruracion_kgmax.es_fragil=matrices.es_fragil where matrices.codigo like curr_cod_matriz);\r\n\r\n\tWITH hojadevida_running AS (\r\n\t\tSELECT cod_matriz, nro_serie_matriz, fecha, kg,\r\n\t\t\tSUM(accion = 'NITRURACION') OVER (ORDER BY fecha ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS nro_nitruraciones\r\n\t\tFROM matrices_hojadevida_v\r\n\t\tWHERE cod_matriz=curr_cod_matriz AND nro_serie_matriz=curr_nro_serie_matriz\r\n\t), hojadevida_estado AS (\r\n\t\tSELECT cod_matriz, nro_serie_matriz, fecha, nro_nitruraciones,\r\n\t\t\tSUM(kg) OVER (PARTITION BY nro_nitruraciones ORDER BY fecha ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS kg_dsdultnit\r\n\t\tFROM hojadevida_running\r\n\t)\r\n\tSELECT\r\n\t\te.cod_matriz,\r\n\t\te.nro_serie_matriz,\r\n\t\te.nro_nitruraciones,\r\n\t\te.kg_dsdultnit,\r\n\t\tIF(k.max__kg is null,@maxvalue_max__kg,k.max__kg) kg_max,\r\n\t\tIF(k.max__kg is null,@maxvalue_max__kg,k.max__kg)-e.kg_dsdultnit as kg_disponibles\r\n\tFROM hojadevida_estado e\r\n\t\tJOIN matrices m ON e.cod_matriz=m.codigo\r\n\t\tLEFT JOIN nitruracion_kgmax k ON e.nro_nitruraciones=k.nro_nitruraciones AND k.es_fragil=m.es_fragil\r\n\tORDER BY e.fecha DESC LIMIT 1;\r\n\r\n\tWITH hojadevida_running AS (\r\n\t\tSELECT fecha, kg,\r\n\t\t\tSUM(accion = 'NITRURACION') OVER (ORDER BY fecha ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS nro_nitruraciones\r\n\t\tFROM matrices_hojadevida_v\r\n\t\tWHERE cod_matriz=curr_cod_matriz AND nro_serie_matriz=curr_nro_serie_matriz\r\n\t)\r\n\tSELECT nro_nitruraciones,\r\n\t\tSUM(kg) OVER (PARTITION BY nro_nitruraciones ORDER BY fecha ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)\r\n\tINTO nro_nitruraciones_out, kg_dsdultnit_out\r\n\tFROM hojadevida_running\r\n\tORDER BY fecha DESC LIMIT 1;\r\nEND\r\n--------------\r\n\r\n"]
[19.925473, "o", "Query OK, 0 rows affected\r\n\r\n--------------\r\nCREATE PROCEDURE infoperfil (IN curr_cod_perfil VARCHAR(30))\r\nBEGIN\r\n\tSELECT * FROM stock_matrices JOIN matrices ON stock_matrices.cod_matriz=matrices.codigo WHERE cod_perfil LIKE curr_cod_perfil;\r\nEND\r\n--------------\r\n\r\n"]
[19.960056, "o", "Query OK, 0 rows affected\r\n\r\n"]
