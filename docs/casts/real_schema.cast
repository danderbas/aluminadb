[19.661931, "o", "--------------\r\nCREATE VIEW load_errors_v AS\r\n\r\nSELECT 'extrusion' AS source_table, s._csv_row AS csv_row,\r\n\tCASE\r\n\t\tWHEN NOT (s.nro_op IS NULL OR s.nro_subop IS NULL OR o.cod_perfil=s.cod_perfil) THEN CONCAT('op ',s.nro_op,'/',s.nro_subop,' is registered for ',o.cod_perfil,', not ',s.cod_perfil)\r\n\t\tWHEN p.codigo IS NULL THEN CONCAT('cod_perfil ',s.cod_perfil,' not in perfiles')\r\n\t\tWHEN s.id_rrhh IS NOT NULL AND r.id IS NULL THEN CONCAT('id_rrhh ',s.id_rrhh,' not in rrhh')\r\n\t\tWHEN s.nro_op IS NULL AND s.nro_subop IS NULL AND s.cod_perfil IS NULL THEN 'no nro_op and no cod_perfil'\r\n\t\tWHEN (TIME_TO_SEC(TIMEDIFF(s.hora_fin,s.hora_inicio))/3600 < 3.5) IS FALSE THEN 'duration >= 3.5h'\r\n\t\tELSE CONCAT('duplicate fecha/hora_inicio/hora_fin (first seen at csv_row ', (SELECT MIN(_csv_row) FROM s_extrusion s2 WHERE s2.fecha<=>s.fecha AND s2.hora_inicio<=>s.hora_inicio AND s2.hora_fin<=>s.hora_fin), ')')\r\n\tEND AS reason,\r\n\tJSON_OBJECT('nro',s.nro,'fecha',s.fecha,'hora_inicio',s.hora_inicio,'hora_fin',s.hora_fin,'id_rrhh',s.id_rrhh,'nro_op',s.nro_op,'nro_subop',s.nro_subop,'cod_perfil',s.cod_perfil) AS row_data\r\nFROM s_extrusion s\r\n\tLEFT JOIN op_extrusion o ON o.nro_op=s.nro_op AND o.nro_subop=s.nro_subop\r\n\tLEFT JOIN perfiles p ON p.codigo=s.cod_perfil\r\n\tLEFT JOIN rrhh r ON r.id=s.id_rrhh\r\nWHERE s._csv_row NOT IN (SELECT MIN(_csv_row) FROM s_extrusion GROUP BY fecha,hora_inicio,hora_fin)\r\n\tOR NOT (s.nro_op IS NULL OR s.nro_subop IS NULL OR o.cod_perfil=s.cod_perfil)\r\n\tOR p.codigo IS NULL\r\n\tOR (s.id_rrhh IS NOT NULL AND r.id IS NULL)\r\n\tOR (s.nro_op IS NULL AND s.nro_subop IS NULL AND s.cod_perfil IS NULL)\r\n\tOR (TIME_TO_SEC(TIMEDIFF(s.hora_fin,s.hora_inicio))/3600 < 3.5) IS FALSE\r\n\r\nUNION ALL\r\n\r\nSELECT 'extrusion_matriz', s._csv_row,\r\n\tCASE\r\n\t\tWHEN e.nro IS NULL THEN CONCAT('nro_extrusion ',s.nro_extrusion,' not in extrusion')\r\n\t\tWHEN m.codigo IS NULL THEN CONCAT('cod_matriz/nro_serie ',s.cod_matriz,'/',s.nro_serie_matriz,' not in stock_matrices')\r\n\t\tWHEN e.cod_perfil <> m.cod_perfil THEN CONCAT('extrusion ',s.nro_extrusion,' is cod_perfil ',e.cod_perfil,', matriz ',s.cod_matriz,' is for ',m.cod_perfil)\r\n\t\tELSE CONCAT('duplicate nro_extrusion (first seen at csv_row ', (SELECT MIN(_csv_row) FROM s_extrusion_matriz s2 WHERE s2.nro_extrusion=s.nro_extrusion), ')')\r\n\tEND,\r\n\tJSON_OBJECT('nro_extrusion',s.nro_extrusion,'cod_matriz',s.cod_matriz,'nro_serie_matriz',s.nro_serie_matriz)\r\nFROM s_extrusion_matriz s\r\n\tLEFT JOIN extrusion e ON e.nro=s.nro_extrusion\r\n\tLEFT JOIN matrices m ON m.codigo=s.cod_matriz\r\nWHERE e.nro IS NULL OR m.codigo IS NULL OR e.cod_perfil <> m.cod_perfil\r\n\tOR s._csv_row NOT IN (SELECT MIN(_csv_row) FROM s_extrusion_matriz GROUP BY nro_extrusion)\r\n\r\nUNION ALL\r\n\r\nSELECT 'extrusion_entrada', s._csv_row,\r\n\tCASE\r\n\t\tWHEN e.nro IS NULL THEN CONCAT('nro_extrusion ',s.nro_extrusion,' not in extrusion')\r\n\t\tWHEN NOT (0 < s.long_tocho__cm AND s.long_tocho__cm <= 80) THEN CONCAT('long_tocho__cm ',s.long_tocho__cm,' out of range (0,80]')\r\n\t\tWHEN s.cantidad <= 0 THEN CONCAT('cantidad ',s.cantidad,' <= 0')\r\n\t\tELSE CONCAT('duplicate nro_extrusion+long_tocho__cm+cantidad+peso_unit__kg (first seen at csv_row ', (SELECT MIN(_csv_row) FROM s_extrusion_entrada s2 WHERE s2.nro_extrusion=s.nro_extrusion AND s2.long_tocho__cm=s.long_tocho__cm AND s2.cantidad=s.cantidad AND s2.peso_unit__kg=s.peso_unit__kg), ')')\r\n\tEND,\r\n\tJSON_OBJECT('nro_extrusion',s.nro_extrusion,'long_tocho__cm',s.long_tocho__cm,'cantidad',s.cantidad,'peso_unit__kg',s.peso_unit__kg)\r\nFROM s_extrusion_entrada s\r\n\tLEFT JOIN extrusion e ON e.nro=s.nro_extrusion\r\nWHERE e.nro IS NULL OR NOT (0 < s.long_tocho__cm AND s.long_tocho__cm <= 80) OR s.cantidad <= 0\r\n\tOR s._csv_row NOT IN (SELECT MIN(_csv_row) FROM s_extrusion_entrada GROUP BY nro_extrusion,long_tocho__cm,cantidad,peso_unit__kg)\r\n\r\nUNION ALL\r\n\r\nSELECT 'extrusion_corte', s._csv_row,\r\n\tCASE\r\n\t\tWHEN e.nro IS NULL THEN CONCAT('nro_extrusion ',s.nro_extrusion,' not in extrusion')\r\n\t\tELSE CONCAT('duplicate nro_extrusion/fecha/hora_inicio/hora_fin (first seen at csv_row ', (SELECT MIN(_csv_row) FROM s_extrusion_corte s2 WHERE s"]
[19.662038, "o", "2.nro_extrusion<=>s.nro_extrusion AND s2.fecha<=>s.fecha AND s2.hora_inicio<=>s.hora_inicio AND s2.hora_fin<=>s.hora_fin), ')')\r\n\tEND,\r\n\tJSON_OBJECT('nro_extrusion',s.nro_extrusion,'fecha',s.fecha,'hora_inicio',s.hora_inicio,'hora_fin',s.hora_fin)\r\nFROM s_extrusion_corte s\r\n\tLEFT JOIN extrusion e ON e.nro=s.nro_extrusion\r\nWHERE e.nro IS NULL\r\n\tOR s._csv_row NOT IN (SELECT MIN(_csv_row) FROM s_extrusion_corte GROUP BY nro_extrusion,fecha,hora_inicio,hora_fin)\r\n\r\nUNION ALL\r\n\r\nSELECT 'extrusion_salida', s._csv_row,\r\n\tCASE\r\n\t\tWHEN e.nro IS NULL THEN CONCAT('nro_extrusion ',s.nro_extrusion,' not in extrusion')\r\n\t\tWHEN s.id_contenedor IS NOT NULL AND c.id_tipo_contenedor IS NULL THEN CONCAT('id_tipo_contenedor/id_contenedor ',s.id_tipo_contenedor,'/',s.id_contenedor,' not in stock_contenedores_perfiles')\r\n\t\tWHEN s.cantidad <= 0 THEN CONCAT('cantidad ',s.cantidad,' <= 0')\r\n\t\tELSE 'duplicate nro_extrusion+long_perfil__m+cantidad+id_tipo_contenedor+id_contenedor'\r\n\tEND,\r\n\tJSON_OBJECT('nro_extrusion',s.nro_extrusion,'long_perfil__m',s.long_perfil__m,'cantidad',s.cantidad,'id_tipo_contenedor',s.id_tipo_contenedor,'id_contenedor',s.id_contenedor)\r\nFROM s_extrusion_salida s\r\n\tLEFT JOIN extrusion e ON e.nro=s.nro_extrusion\r\n\tLEFT JOIN stock_contenedores_perfiles c ON c.id_tipo_contenedor=s.id_tipo_contenedor AND c.id_contenedor=s.id_contenedor\r\nWHERE e.nro IS NULL OR (s.id_contenedor IS NOT NULL AND c.id_tipo_contenedor IS NULL) OR s.cantidad <= 0\r\n\tOR s._csv_row NOT IN (SELECT MIN(_csv_row) FROM s_extrusion_salida GROUP BY nro_extrusion,long_perfil__m,cantidad,id_tipo_contenedor,id_contenedor)\r\n\r\nUNION ALL\r\n\r\nSELECT 'extrusion_muestraculote', s._csv_row,\r\n\tCASE WHEN e.nro IS NULL THEN CONCAT('nro_extrusion ',s.nro_extrusion,' not in extrusion') ELSE 'duplicate nro_extrusion+cant_culote+peso_total__kg' END,\r\n\tJSON_OBJECT('nro_extrusion',s.nro_extrusion,'cant_culote',s.cant_culote,'peso_total__kg',s.peso_total__kg)\r\nFROM s_extrusion_muestraculote s\r\n\tLEFT JOIN extrusion e ON e.nro=s.nro_extrusion\r\nWHERE e.nro IS NULL\r\n\t"]
[19.662548, "o", "OR s._csv_row NOT IN (SELECT MIN(_csv_row) FROM s_extrusion_muestraculote GROUP BY nro_extrusion,cant_culote,peso_total__kg)\r\n\r\nUNION ALL\r\n\r\nSELECT 'extrusion_muestraperfil', s._csv_row,\r\n\tCASE WHEN e.nro IS NULL THEN CONCAT('nro_extrusion ',s.nro_extrusion,' not in extrusion') ELSE 'duplicate nro_extrusion+nro_salida+long_muestraperfil__cm+peso_muestra__g' END,\r\n\tJSON_OBJECT('nro_extrusion',s.nro_extrusion,'nro_salida',s.nro_salida,'long_muestraperfil__cm',s.long_muestraperfil__cm,'peso_muestra__g',s.peso_muestra__g)\r\nFROM s_extrusion_muestraperfil s\r\n\tLEFT JOIN extrusion e ON e.nro=s.nro_extrusion\r\nWHERE e.nro IS NULL\r\n\tOR s._csv_row NOT IN (SELECT MIN(_csv_row) FROM s_extrusion_muestraperfil GROUP BY nro_extrusion,nro_salida,long_muestraperfil__cm,peso_muestra__g)\r\n\r\nUNION ALL\r\n\r\nSELECT 'extrusion_stats', s._csv_row,\r\n\tCASE\r\n\t\tWHEN e.nro IS NULL THEN CONCAT('nro_extrusion ',s.nro_extrusion,' not in extrusion')\r\n\t\tWHEN s.extrusion_detenida AND s.comentarios IS NULL THEN 'extrusion_detenida is true but comentarios is empty'\r\n\t\tELSE 'duplicate nro_extrusion'\r\n\tEND,\r\n\tJSON_OBJECT('nro_extrusion',s.nro_extrusion,'extrusion_detenida',s.extrusion_detenida,'comentarios',s.comentarios)\r\nFROM s_extrusion_stats s\r\n\tLEFT JOIN extrusion e ON e.nro=s.nro_extrusion\r\nWHERE e.nro IS NULL OR (s.extrusion_detenida AND s.comentarios IS NULL)\r\n\tOR s._csv_row NOT IN (SELECT MIN(_csv_row) FROM s_extrusion_stats GROUP BY nro_extrusion)\r\n\r\nUNION ALL\r\n\r\nSELECT 'cortetochos', s._csv_row,\r\n\tCASE\r\n\t\tWHEN s.nro_tocho0 IS NOT NULL AND t0.nro IS NULL THEN CONCAT('nro_tocho0 ',s.nro_tocho0,' not in tocho0')\r\n\t\tWHEN s.nro_op IS NOT NULL AND s.nro_subop IS NOT NULL AND o.nro_op IS NULL THEN CONCAT('op ',s.nro_op,'/',s.nro_subop,' not in op_extrusion')\r\n\t\tWHEN s.id_rrhh IS NOT NULL AND r.id IS NULL THEN CONCAT('id_rrhh ',s.id_rrhh,' not in rrhh')\r\n\t\tWHEN s.cant_tochos <= 0 THEN CONCAT('cant_tochos ',s.cant_tochos,' <= 0')\r\n\t\tELSE CONCAT('duplicate nro_tocho0+long_inicial__cm (first seen at csv_row ', (SELECT MIN(_csv_row) FROM s_cortetochos s2 WHERE s2.nro_tocho0=s.nro_tocho0 AND s2.long_inicial__cm=s.long_inicial__cm), ')')\r\n\tEND,\r\n\tJSON_OBJECT('nro',s.nro,'nro_op',s.nro_op,'nro_subop',s.nro_subop,'nro_tocho0',s.nro_tocho0,'long_inicial__cm',s.long_inicial__cm,'cant_tochos',s.cant_tochos,'id_rrhh',s.id_rrhh)\r\nFROM s_cortetochos s\r\n\tLEFT JOIN tocho0 t0 ON t0.nro=s.nro_tocho0\r\n\tLEFT JOIN op_extrusion o ON o.nro_op=s.nro_op AND o.nro_subop=s.nro_subop\r\n\tLEFT JOIN rrhh r ON r.id=s.id_rrhh\r\nWHERE (s.nro_tocho0 IS NOT NULL AND t0.nro IS NULL)\r\n\tOR (s.nro_op IS NOT NULL AND s.nro_subop IS NOT NULL AND o.nro_op IS NULL)\r\n\tOR (s.id_rrhh IS NOT NULL AND r.id IS NULL)\r\n\tOR s.cant_tochos <= 0\r\n\tOR (s.nro_tocho0 IS NOT NULL AND s.long_inicial__cm IS NOT NULL AND s._csv_row NOT IN (\r\n\t\tSELECT MIN(_csv_row) FROM s_cortetochos WHERE nro_tocho0 IS NOT NULL AND long_inicial__cm IS NOT NULL GROUP BY nro_tocho0,long_inicial__cm\r\n\t))\r\n\r\nUNION ALL\r\n\r\nSELECT 'perfiles', s._csv_row,\r\n\tCASE WHEN tp.id IS NULL THEN CONCAT('id_tipo ',s.id_tipo,' not in tipos_perfiles') ELSE CONCAT('duplicate codigo (first seen at csv_row ', (SELECT MIN(_csv_row) FROM s_perfiles s2 WHERE s2.codigo=s.codigo), ')') END,\r\n\tJSON_OBJECT('codigo',s.codigo,'id_tipo',s.id_tipo,'codigo_externo',s.codigo_externo)\r\nFROM s_perfiles s\r\n\tLEFT JOIN tipos_perfiles tp ON tp.id=s.id_tipo\r\nWHERE tp.id IS NULL\r\n\tOR s._csv_row NOT IN (SELECT MIN(_csv_row) FROM s_perfiles GROUP BY codigo)\r\n\r\nUNION ALL\r\n\r\nSELECT 'matrices_correccion', s._csv_row,\r\n\tCASE WHEN sm.cod_matriz IS NULL THEN CONCAT('cod_matriz/nro_serie ',s.cod_matriz,'/',s.nro_serie_matriz,' not in stock_matrices') ELSE CONCAT('id_rrhh ',s.id_rrhh,' not in rrhh') END,\r\n\tJSON_OBJECT('fecha',s.fecha,'id_rrhh',s.id_rrhh,'cod_matriz',s.cod_matriz,'nro_serie_matriz',s.nro_serie_matriz)\r\nFROM s_matrices_correccion s\r\n\tLEFT JOIN stock_matrices sm ON sm.cod_matriz=s.cod_matriz AND sm.nro_serie=s.nro_serie_matriz\r\n\tLEFT JOIN rrhh r ON r.id=s.id_rrhh\r\nWHERE sm.cod_matriz IS NULL OR r.id IS NULL\r\n\r\nUNION ALL\r\n\r\nSELECT 'matrices_mediciondureza', s._csv_row,\r\n\tCASE\r\n\t\tW"]
[19.662903, "o", "HEN sm.cod_matriz IS NULL THEN CONCAT('cod_matriz/nro_serie ',s.cod_matriz,'/',s.nro_serie_matriz,' not in stock_matrices')\r\n\t\tWHEN r.id IS NULL THEN CONCAT('id_rrhh ',s.id_rrhh,' not in rrhh')\r\n\t\tELSE CONCAT('duplicate cod_matriz+nro_serie_matriz+fecha (first seen at csv_row ', (SELECT MIN(_csv_row) FROM s_matrices_mediciondureza s2 WHERE s2.cod_matriz=s.cod_matriz AND s2.nro_serie_matriz=s.nro_serie_matriz AND s2.fecha=s.fecha), ')')\r\n\tEND,\r\n\tJSON_OBJECT('fecha',s.fecha,'id_rrhh',s.id_rrhh,'cod_matriz',s.cod_matriz,'nro_serie_matriz',s.nro_serie_matriz,'dureza__rhc',s.dureza__rhc)\r\nFROM s_matrices_mediciondureza s\r\n\tLEFT JOIN stock_matrices sm ON sm.cod_matriz=s.cod_matriz AND sm.nro_serie=s.nro_serie_matriz\r\n\tLEFT JOIN rrhh r ON r.id=s.id_rrhh\r\nWHERE sm.cod_matriz IS NULL OR r.id IS NULL\r\n\tOR s._csv_row NOT IN (SELECT MIN(_csv_row) FROM s_matrices_mediciondureza GROUP BY cod_matriz,nro_serie_matriz,fecha)\r\n\r\nUNION ALL\r\n\r\nSELECT 'matrices_nitruracion', s._csv_row,\r\n\tCASE\r\n\t\tWHEN sm.cod_matriz IS NULL THEN CONCAT('cod_matriz/nro_serie ',s.cod_matriz,'/',s.nro_serie_matriz,' not in stock_matrices')\r\n\t\tWHEN r1.id IS NULL THEN CONCAT('id_rrhh_salida ',s.id_rrhh_salida,' not in rrhh')\r\n\t\tWHEN s.id_rrhh_retorno IS NOT NULL AND r2.id IS NULL THEN CONCAT('id_rrhh_retorno ',s.id_rrhh_retorno,' not in rrhh')\r\n\t\tWHEN s.fecha_retorno IS NOT NULL AND s.fecha_salida > s.fecha_retorno THEN 'fecha_salida is after fecha_retorno'\r\n\t\tELSE 'duplicate fecha_salida or fecha_retorno for this cod_matriz+nro_serie_matriz'\r\n\tEND,\r\n\tJSON_OBJECT('fecha_salida',s.fecha_salida,'fecha_retorno',s.fecha_retorno,'id_rrhh_salida',s.id_rrhh_salida,'id_rrhh_retorno',s.id_rrhh_retorno,'cod_matriz',s.cod_matriz,'nro_serie_matriz',s.nro_serie_matriz)\r\nFROM s_matrices_nitruracion s\r\n\tLEFT JOIN stock_matrices sm ON sm.cod_matriz=s.cod_matriz AND sm.nro_serie=s.nro_serie_matriz\r\n\tLEFT JOIN rrhh r1 ON r1.id=s.id_rrhh_salida\r\n\tLEFT JOIN rrhh r2 ON r2.id=s.id_rrhh_retorno\r\nWHERE sm.cod_matriz IS NULL OR r1.id IS NULL OR (s.id_rrhh_retorno IS NOT NULL AND r2.id IS NULL)\r\n\tOR (s.fecha_retorno IS NOT NULL AND s.fecha_salida > s.fecha_retorno)\r\n\tOR s._csv_row NOT IN (SELECT MIN(_csv_row) FROM s_matrices_nitruracion GROUP BY fecha_salida,cod_matriz,nro_serie_matriz)\r\n\tOR (s.fecha_retorno IS NOT NULL AND s._csv_row NOT IN (SELECT MIN(_csv_row) FROM s_matrices_nitruracion WHERE fecha_retorno IS NOT NULL GROUP BY fecha_retorno,cod_matriz,nro_serie_matriz))\r\n\r\nUNION ALL\r\n\r\nSELECT 'op_extrusion_matriz', s._csv_row,\r\n\tCASE\r\n\t\tWHEN o.nro_op IS NULL THEN CONCAT('op ',s.nro_op,'/',s.nro_subop,' not in op_extrusion')\r\n\t\tWHEN s.nro_serie_matriz IS NOT NULL AND sm.cod_matriz IS NULL THEN CONCAT('cod_matriz/nro_serie ',s.cod_matriz,'/',s.nro_serie_matriz,' not in stock_matrices')\r\n\t\tELSE 'duplicate nro_op+nro_subop+cod_matriz+nro_serie_matriz'\r\n\tEND,\r\n\tJSON_OBJECT('nro_op',s.nro_op,'nro_subop',s.nro_subop,'cod_matriz',s.cod_matriz,'nro_serie_matriz',s.nro_serie_matriz)\r\nFROM s_op_extrusion_matriz s\r\n\tLEFT JOIN op_extrusion o ON o.nro_op=s.nro_op AND o.nro_subop=s.nro_subop\r\n\tLEFT JOIN stock_matrices sm ON sm.cod_matriz=s.cod_matriz AND sm.nro_serie=s.nro_serie_matriz\r\nWHERE o.nro_op IS NULL OR (s.nro_serie_matriz IS NOT NULL AND sm.cod_matriz IS NULL)\r\n\tOR s._csv_row NOT IN (SELECT MIN(_csv_row) FROM s_op_extrusion_matriz GROUP BY nro_op,nro_subop,cod_matriz,nro_serie_matriz)\r\n\r\nUNION ALL\r\n\r\nSELECT 'op_extrusion_parapedido', s._csv_row,\r\n\tCASE\r\n\t\tWHEN o.nro_op IS NULL THEN CONCAT('op ',s.nro_op,'/',s.nro_subop,' not in op_extrusion')\r\n\t\tWHEN p.nro_pedido IS NULL THEN CONCAT('pedido ',s.nro_pedido,'/',s.nro_subpedido,' not in pedidos')\r\n\t\tWHEN p.codigo IS NULL THEN CONCAT('pedido ',s.nro_pedido,'/',s.nro_subpedido,' has no codigo recorded')\r\n\t\tWHEN o.cod_perfil <> p.codigo THEN CONCAT('op is cod_perfil ',o.cod_perfil,', pedido wants ',p.codigo)\r\n\t\tELSE 'duplicate nro_op+nro_subop+nro_pedido+nro_subpedido'\r\n\tEND,\r\n\tJSON_OBJECT('nro_op',s.nro_op,'nro_subop',s.nro_subop,'nro_pedido',s.nro_pedido,'nro_subpedido',s.nro_subpedido)\r\nFROM s_op_extrusion_parapedido s\r\n\tLEFT JOIN op_extrusio"]
[19.663131, "o", "n o ON o.nro_op=s.nro_op AND o.nro_subop=s.nro_subop\r\n\tLEFT JOIN pedidos p ON p.nro_pedido=s.nro_pedido AND p.nro_subpedido=s.nro_subpedido\r\nWHERE o.nro_op IS NULL OR p.nro_pedido IS NULL OR p.codigo IS NULL OR o.cod_perfil <> p.codigo\r\n\tOR s._csv_row NOT IN (SELECT MIN(_csv_row) FROM s_op_extrusion_parapedido GROUP BY nro_op,nro_subop,nro_pedido,nro_subpedido)\r\n\r\nUNION ALL\r\n\r\nSELECT 'op_pintura_parapedido', s._csv_row,\r\n\tCASE\r\n\t\tWHEN o.nro_op IS NULL THEN CONCAT('op ',s.nro_op,'/',s.nro_subop,' not in op_pintura')\r\n\t\tWHEN p.nro_pedido IS NULL THEN CONCAT('pedido ',s.nro_pedido,'/',s.nro_subpedido,' not in pedidos')\r\n\t\tWHEN o.codigo IS NULL THEN CONCAT('op ',s.nro_op,'/',s.nro_subop,' has no codigo recorded')\r\n\t\tWHEN p.codigo IS NULL THEN CONCAT('pedido ',s.nro_pedido,'/',s.nro_subpedido,' has no codigo recorded')\r\n\t\tWHEN o.codigo <> p.codigo THEN CONCAT('op is codigo ',o.codigo,', pedido wants ',p.codigo)\r\n\t\tELSE 'duplicate nro_op+nro_subop+nro_pedido+nro_subpedido'\r\n\tEND,\r\n\tJSON_OBJECT('nro_op',s.nro_op,'nro_subop',s.nro_subop,'nro_pedido',s.nro_pedido,'nro_subpedido',s.nro_subpedido)\r\nFROM s_op_pintura_parapedido s\r\n\tLEFT JOIN op_pintura o ON o.nro_op=s.nro_op AND o.nro_subop=s.nro_subop\r\n\tLEFT JOIN pedidos p ON p.nro_pedido=s.nro_pedido AND p.nro_subpedido=s.nro_subpedido\r\nWHERE o.nro_op IS NULL OR p.nro_pedido IS NULL OR o.codigo IS NULL OR p.codigo IS NULL OR o.codigo <> p.codigo\r\n\tOR s._csv_row NOT IN (SELECT MIN(_csv_row) FROM s_op_pintura_parapedido GROUP BY nro_op,nro_subop,nro_pedido,nro_subpedido)\r\n\r\nUNION ALL\r\n\r\nSELECT 'envejecimiento_canastos', s._csv_row,\r\n\tCASE\r\n\t\tWHEN e.nro IS NULL THEN CONCAT('nro_envejecimiento ',s.nro_envejecimiento,' not in envejecimiento')\r\n\t\tWHEN c.id_tipo_contenedor IS NULL THEN CONCAT('id_tipo_contenedor/id_contenedor ',s.id_tipo_contenedor,'/',s.id_contenedor,' not in stock_contenedores_perfiles')\r\n\t\tWHEN NOT (s.id_tipo_contenedor=1 OR (s.id_tipo_contenedor=0 AND s.id_contenedor=0)) THEN 'id_tipo_contenedor/id_contenedor fails the (1,*) or (0,0) rule'\r\n\t\tELSE 'duplicate nro_canasto+nro_envejecimiento'\r\n\tEND,\r\n\tJSON_OBJECT('nro_canasto',s.nro_canasto,'nro_envejecimiento',s.nro_envejecimiento,'id_tipo_contenedor',s.id_tipo_contenedor,'id_contenedor',s.id_contenedor)\r\nFROM s_envejecimiento_canastos s\r\n\tLEFT JOIN envejecimiento e ON e.nro=s.nro_envejecimiento\r\n\tLEFT JOIN stock_contenedores_perfiles c ON c.id_tipo_contenedor=s.id_tipo_contenedor AND c.id_contenedor=s.id_contenedor\r\nWHERE e.nro IS NULL OR c.id_tipo_contenedor IS NULL\r\n\tOR NOT (s.id_tipo_contenedor=1 OR (s.id_tipo_contenedor=0 AND s.id_contenedor=0))\r\n\tOR s._csv_row NOT IN (SELECT MIN(_csv_row) FROM s_envejecimiento_canastos GROUP BY nro_canasto,nro_envejecimiento)\r\n\r\nUNION ALL\r\n\r\nSELECT 'envejecimiento_canastos_detalle', s._csv_row,\r\n\tCASE\r\n\t\tWHEN NOT EXISTS (SELECT 1 FROM envejecimiento_canastos c WHERE c.nro_canasto=s.nro_canasto) THEN CONCAT('nro_canasto ',s.nro_canasto,' not in envejecimiento_canastos')\r\n\t\tWHEN p.codigo IS NULL THEN CONCAT('cod_perfil ',s.cod_perfil,' not in perfiles')\r\n\t\tWHEN s.nro_op IS NOT NULL AND s.nro_subop IS NOT NULL AND o.nro_op IS NULL THEN CONCAT('op ',s.nro_op,'/',s.nro_subop,' not in op_extrusion')\r\n\t\tWHEN s.long_perfil__m <= 0 THEN CONCAT('long_perfil__m ',s.long_perfil__m,' <= 0')\r\n\t\tWHEN s.cantidad <= 0 THEN CONCAT('cantidad ',s.cantidad,' <= 0')\r\n\t\tELSE CONCAT('duplicate nro_canasto+cod_perfil+long_perfil__m+nro_op+nro_subop+cantidad (first seen at csv_row ', (SELECT MIN(_csv_row) FROM s_envejecimiento_canastos_detalle s2 WHERE s2.nro_canasto=s.nro_canasto AND s2.cod_perfil=s.cod_perfil AND s2.long_perfil__m=s.long_perfil__m AND s2.nro_op<=>s.nro_op AND s2.nro_subop<=>s.nro_subop AND s2.cantidad=s.cantidad), ')')\r\n\tEND,\r\n\tJSON_OBJECT('nro_canasto',s.nro_canasto,'cod_perfil',s.cod_perfil,'long_perfil__m',s.long_perfil__m,'cantidad',s.cantidad,'nro_op',s.nro_op,'nro_subop',s.nro_subop)\r\nFROM s_envejecimiento_canastos_detalle s\r\n\tLEFT JOIN perfiles p ON p.codigo=s.cod_perfil\r\n\tLEFT JOIN op_extrusion o ON o.nro_op=s.nro_op AND o.nro_subop=s.nro_subop\r\n\r\n\r\n\r\nWHERE NOT EXISTS (SELECT 1"]
[19.663353, "o", " FROM envejecimiento_canastos c WHERE c.nro_canasto=s.nro_canasto) OR p.codigo IS NULL\r\n\tOR (s.nro_op IS NOT NULL AND s.nro_subop IS NOT NULL AND o.nro_op IS NULL)\r\n\tOR s.long_perfil__m <= 0 OR s.cantidad <= 0\r\n\tOR s._csv_row NOT IN (SELECT MIN(_csv_row) FROM s_envejecimiento_canastos_detalle GROUP BY nro_canasto,cod_perfil,long_perfil__m,nro_op,nro_subop,cantidad)\r\n\r\nUNION ALL\r\n\r\nSELECT 'pinturas', s._csv_row,\r\n\tCASE WHEN s.nro_carga IS NOT NULL AND s.nro_subcarga IS NOT NULL AND cpd.nro_carga IS NULL THEN CONCAT('nro_carga/nro_subcarga ',s.nro_carga,'/',s.nro_subcarga,' not in cargas_pinturas_detalle') ELSE CONCAT('duplicate nro_caja (first seen at csv_row ', (SELECT MIN(_csv_row) FROM s_pinturas s2 WHERE s2.nro_caja=s.nro_caja), ')') END,\r\n\tJSON_OBJECT('nro_caja',s.nro_caja,'nro_carga',s.nro_carga,'nro_subcarga',s.nro_subcarga)\r\nFROM s_pinturas s\r\n\tLEFT JOIN cargas_pinturas_detalle cpd ON cpd.nro_carga=s.nro_carga AND cpd.nro_subcarga=s.nro_subcarga\r\nWHERE (s.nro_carga IS NOT NULL AND s.nro_subcarga IS NOT NULL AND cpd.nro_carga IS NULL)\r\n\tOR s._csv_row NOT IN (SELECT MIN(_csv_row) FROM s_pinturas GROUP BY nro_caja)\r\n\r\nUNION ALL\r\n\r\nSELECT 'd_stock_pinturas', s._csv_row,\r\n\tCASE\r\n\t\tWHEN r.id IS NULL THEN CONCAT('id_rrhh ',s.id_rrhh,' not in rrhh')\r\n\t\tWHEN p.nro_caja IS NULL THEN CONCAT('nro_caja ',s.nro_caja,' not in pinturas')\r\n\t\tWHEN NOT (s.d_cantidad=1 OR s.d_cantidad=-1) THEN CONCAT('d_cantidad ',s.d_cantidad,' is not 1 or -1')\r\n\t\tELSE 'es_fix is false but fecha is empty'\r\n\tEND,\r\n\tJSON_OBJECT('fecha',s.fecha,'id_rrhh',s.id_rrhh,'nro_caja',s.nro_caja,'d_cantidad',s.d_cantidad,'es_fix',s.es_fix)\r\nFROM s_d_stock_pinturas s\r\n\tLEFT JOIN rrhh r ON r.id=s.id_rrhh\r\n\tLEFT JOIN pinturas p ON p.nro_caja=s.nro_caja\r\nWHERE r.id IS NULL OR p.nro_caja IS NULL OR NOT (s.d_cantidad=1 OR s.d_cantidad=-1)\r\n\tOR ((s.es_fix=FALSE AND s.fecha IS NOT NULL) OR s.es_fix=TRUE) IS FALSE\r\n\r\nUNION ALL\r\n\r\nSELECT 'pedidos', s._csv_row,\r\n\tCASE\r\n\t\tWHEN gp.nro_pedido IS NULL THEN CONCAT('nro_pedido ',s.nro_pedido,' not in generacion_pedidos')\r\n\t\tWHEN s.codigo IS NOT NULL AND p.codigo IS NULL THEN CONCAT('codigo ',s.codigo,' not in perfiles')\r\n\t\tWHEN tp.id IS NULL THEN CONCAT('id_tipo_pedido ',s.id_tipo_pedido,' not in tipos_pedidos')\r\n\t\tWHEN ta.id IS NULL THEN CONCAT('id_tipo_acabado ',s.id_tipo_acabado,' not in tipos_acabado')\r\n\t\tWHEN c.id IS NULL THEN CONCAT('id_color ',s.id_color,' not in colores')\r\n\t\tWHEN ep.id IS NULL THEN CONCAT('id_estado ',s.id_estado,' not in estados_pedidos')\r\n\t\tWHEN s.id_tipo_acabado=1 AND s.id_color=0 THEN 'id_tipo_acabado=1 (painted) but id_color=0 (natural)'\r\n\t\tWHEN s.long__m IS NOT NULL AND NOT (0 < s.long__m AND s.long__m < 8) THEN CONCAT('long__m ',s.long__m,' out of range (0,8)')\r\n\t\tELSE CONCAT('duplicate nro_pedido+nro_subpedido (first seen at csv_row ', (SELECT MIN(_csv_row) FROM s_pedidos s2 WHERE s2.nro_pedido=s.nro_pedido AND s2.nro_subpedido=s.nro_subpedido), ')')\r\n\tEND,\r\n\tJSON_OBJECT('nro_pedido',s.nro_pedido,'nro_subpedido',s.nro_subpedido,'id_tipo_pedido',s.id_tipo_pedido,'codigo',s.codigo,'long__m',s.long__m,'id_tipo_acabado',s.id_tipo_acabado,'id_color',s.id_color,'id_estado',s.id_estado)\r\nFROM s_pedidos s\r\n\tLEFT JOIN generacion_pedidos gp ON gp.nro_pedido=s.nro_pedido\r\n\tLEFT JOIN perfiles p ON p.codigo=s.codigo\r\n\tLEFT JOIN tipos_pedidos tp ON tp.id=s.id_tipo_pedido\r\n\tLEFT JOIN tipos_acabado ta ON ta.id=s.id_tipo_acabado\r\n\tLEFT JOIN colores c ON c.id=s.id_color\r\n\tLEFT JOIN estados_pedidos ep ON ep.id=s.id_estado\r\nWHERE gp.nro_pedido IS NULL\r\n\tOR (s.codigo IS NOT NULL AND p.codigo IS NULL)\r\n\tOR tp.id IS NULL OR ta.id IS NULL OR c.id IS NULL OR ep.id IS NULL\r\n\tOR (s.id_tipo_acabado=1 AND s.id_color=0)\r\n\tOR (s.long__m IS NOT NULL AND NOT (0 < s.long__m AND s.long__m < 8))\r\n\tOR s._csv_row NOT IN (SELECT MIN(_csv_row) FROM s_pedidos GROUP BY nro_pedido,nro_subpedido)\r\n\r\nUNION ALL\r\n\r\nSELECT 'pedidos_expedicion', s._csv_row,\r\n\tCASE WHEN p.nro_pedido IS NULL THEN CONCAT('pedido ',s.nro_pedido,'/',s.nro_subpedido,' not in pedidos') ELSE 'duplicate nro_pedido+nro_subpedido+fecha+cant_perfiles' END,\r\n\tJSON_OBJECT('"]
[19.663402, "o", "nro_pedido',s.nro_pedido,'nro_subpedido',s.nro_subpedido,'fecha',s.fecha,'cant_perfiles',s.cant_perfiles)\r\nFROM s_pedidos_expedicion s\r\n\tLEFT JOIN pedidos p ON p.nro_pedido=s.nro_pedido AND p.nro_subpedido=s.nro_subpedido\r\nWHERE p.nro_pedido IS NULL\r\n\tOR (s.fecha IS NOT NULL AND s._csv_row NOT IN (\r\n\t\tSELECT MIN(_csv_row) FROM s_pedidos_expedicion WHERE fecha IS NOT NULL GROUP BY nro_pedido,nro_subpedido,fecha,cant_perfiles\r\n\t))\r\n--------------\r\n\r\n"]
